{
  // Bypass zones shared by every consumer: both apps' --proxy-bypass-list flags,
  // NO_PROXY of the settings sync (Claude/Codex/WSL), the system proxy bypass, the
  // browser profile (usually the corporate zones). Each zone is written in two forms
  // ('example.com' and '*.example.com'); localhost/private ranges are added by the
  // code. Real domains live only in the user config.
  "bypassDomains": [],
  // TLDs that never leave through the chain exit (*.tld): the browser profile bypass
  // and the system proxy bypass are both built from this one list.
  "directTlds": [],
  // Restart of an already running copy without our proxy flags: how long to wait for
  // it to close after a window close request before killing the rest, sec.
  "restartGraceSeconds": 15,
  // Closing a desktop app before an update installation (Claude and Codex): wait for a
  // graceful exit, then kill; the pause after the kill before the installation, sec.
  "closeWaitSeconds": 25,
  "killSettleSeconds": 3,
  // Windows PowerShell — an OS component; used by the guards and the Claude update.
  "powerShellPath": "%WINDIR%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",

  // WPF UI settings; the CLI is always English.
  "ui": {
    // "auto" — system language, fallback English; otherwise a code ("en", "ru").
    "language": "auto",
    // At GUI start: check for Claude/Codex updates (read-only, no chain, no UAC).
    "checkUpdatesOnStart": true,
    // At GUI start: check GitHub releases of the application itself.
    "checkAppUpdatesOnStart": true,
    // false — the card is collapsed to one compact status row; remembered.
    "chainCardExpanded": true,
    "guardsCardExpanded": true
  },
  "logging": {
    // Environment variables are expanded.
    "directory": "%LOCALAPPDATA%\\PrivateNetRouting\\logs",
    // "debug" | "info" | "warn" | "error"; unknown — info.
    "level": "info",
    // Rotation: size threshold and how many old files to keep.
    "maxBytes": 1000000,
    "keep": 2
  },

  "claude": {
    // false — hide the Claude launch/update buttons, tray item and startup check;
    // `pnr launch`/`pnr update` refuse. The guards, chain and watchdog keep working.
    "enabled": true,
    // Desktop executable (MSIX execution alias); env vars are expanded.
    "aliasPath": "%LOCALAPPDATA%\\Microsoft\\WindowsApps\\claude-desktop.exe",
    // Main process name — closed before an update installation.
    "processName": "Claude",
    // Claude Code settings.json: the sync keeps the proxy env (HTTP(S)_PROXY/NO_PROXY)
    // there; only the env keys change, every other key survives, but the file is
    // re-serialised (comments and formatting are not kept); .pnr-bak-* backups.
    "settingsPath": "%USERPROFILE%\\.claude\\settings.json",
    // Ban lists of the direct-access guard (the guard applies the union with the Codex
    // lists): exact names for the hosts layer —
    "banHosts": [
      "claude.ai", "claude.com", "anthropic.com", "claudeusercontent.com",
      "claudemcpclient.com", "claudemcpcontent.com", "claude.dev", "clau.de",
      "api.anthropic.com", "console.anthropic.com", "statsig.anthropic.com",
      "downloads.claude.ai", "a.claude.ai", "assets.claude.ai", "assets-proxy.anthropic.com",
      "anthropic.qualtrics.com", "servd-anthropic-website.b-cdn.net"
    ],
    // — and subtree apexes for the NRPT layer.
    "banTrees": [
      "claude.ai", "claude.com", "anthropic.com", "claudeusercontent.com",
      "claudemcpclient.com", "claudemcpcontent.com", "claude.dev", "clau.de"
    ],
    // Anthropic subnets for the firewall outbound Block (Anthropic runs its own
    // network, so banning by destination IP is possible).
    "firewallSubnets": [ "160.79.104.0/21", "2607:6bc0::/48", "2607:6bc0:11::/48" ],
    // Manual MSIX update through the chain: check (before any bring-up, no UAC) →
    // download → Publisher verification → install.
    "update": {
      // Get-AppxPackage -Name; the feed/journal URLs are filtered by the host.
      "packageName": "Claude",
      "packageHost": "downloads.claude.ai",
      // Claude's own update feed (the endpoint its built-in updater polls); asked
      // through the live chain. Empty — do not ask (the AppX journal stays).
      "updateFeedUrl": "https://api.anthropic.com/api/desktop/win32/x64/msix/update",
      "feedTimeoutSeconds": 15,
      "journalMaxEvents": 400,
      // Cache of packages and chunks; env vars are expanded.
      "cacheDir": "%LOCALAPPDATA%\\PrivateNetRouting\\update-cache",
      // Chunked parallel download (a single stream through the chain hits DoH latency).
      "chunkBytes": 8388608,
      "parallelChunks": 6,
      "chunkRetries": 3,
      "retryDelaySeconds": 5,
      "chunkTimeoutSeconds": 1800,
      // The HEAD request asking the package size before the download.
      "headTimeoutSeconds": 30
    }
  },

  "codex": {
    // false — hide the Codex buttons/commands (see claude.enabled).
    "enabled": true,
    // Launch goes through Invoke-CommandInDesktopPackage: the packaged stub loses
    // arguments; flags and env reach only the package-context process.
    "packageName": "OpenAI.Codex",
    "appId": "App",
    "appExecutable": "app\\ChatGPT.exe",
    // Main process name: already-running detection, closing before an update, the
    // watchdog activity check.
    "processName": "ChatGPT",
    // config.toml: the sync adds [features] respect_system_proxy = true; surgical
    // edits, .pnr-bak-* backups.
    "settingsPath": "%USERPROFILE%\\.codex\\config.toml",
    // CODEX_HOME/.env: the sync keeps the proxy env there — the embedded CLI core
    // loads it after start (the desktop app strips inherited proxy env from children).
    "envPath": "%USERPROFILE%\\.codex\\.env",
    // Ban lists of the direct-access guard (union with the Claude lists): hosts —
    "banHosts": [
      "openai.com", "chatgpt.com", "oaistatic.com", "oaiusercontent.com", "chat.com", "sora.com",
      "chatgpt.site", "oaistatsig.com", "crixet.com",
      "ab.chatgpt.com", "api.openai.com", "auth.openai.com", "platform.openai.com", "cdn.oaistatic.com",
      "persistent.oaistatic.com", "releases.openai.com",
      "openai.qualtrics.com", "chatgpt.livekit.cloud", "openai.com.cdn.cloudflare.net",
      "openaicom.imgix.net", "openaiassets.blob.core.windows.net",
      "openaicomproductionae4b.blob.core.windows.net", "openaiapi-site.azureedge.net",
      "production-openaicom-storage.azureedge.net", "openaicom-api-bdcpf8c6d2e9atf6.z01.azurefd.net"
    ],
    // — and NRPT subtree apexes.
    "banTrees": [
      "openai.com", "chatgpt.com", "oaistatic.com", "oaiusercontent.com", "chat.com", "sora.com",
      "chatgpt.site", "oaistatsig.com", "crixet.com"
    ],
    // Empty by default: OpenAI's endpoints ride on shared clouds (Cloudflare anycast;
    // only egress ranges are published) — nothing of its own to ban by destination IP.
    "firewallSubnets": [],
    // Update through the Microsoft Store (no downloads of our own, no UAC).
    "update": {
      // Store catalog key (a public constant).
      "storeProductId": "9PLM9XGG6VKS",
      // OpenAI's version manifest (names the offered version only; asked through the
      // live chain — the host is under the ban). Empty — do not ask.
      "updateVersionUrl": "https://persistent.oaistatic.com/codex-app-prod/windows-store-update.json",
      // Hard limit of one Store update (search, download, install), sec.
      "updateTimeoutSeconds": 1800
    }
  },

  // The local CONNECT proxy. tailscale mode: resolves names itself over DoH and dials
  // by IP through the sidecar (the sidecar's own proxies use the system resolver,
  // poisoned by the ban). socks5 mode: HTTP CONNECT ↔ SOCKS5 translation for a plain
  // SOCKS5 upstream. http mode: the local proxy does not run at all (the flag is
  // ignored there) — the provided HTTP proxy speaks CONNECT itself.
  "forwardProxy": {
    // true — the proxy runs as part of the chain (and `pnr proxy` may start it).
    // false — no local proxy at all: socks5 mode — every client (both apps' flags and
    // env, the WSL sync, the updater, the checks, the browser profile) is pointed at
    // chain.socks5.upstream itself, so it must answer HTTP CONNECT as well as SOCKS5
    // (a mixed inbound, e.g. sing-box); tailscale mode — refused (the proxy is
    // load-bearing there); http mode — irrelevant, the proxy never runs there.
    "enabled": true,
    // Main listener (clients connect here).
    "listen": "127.0.0.1:18081",
    // One-shot bind on the WSL NAT gateway at start (the adapter address is read with
    // retries; no monitoring).
    "bindWslGateway": true,
    // Run the proxy in a detached worker (--proxy-worker) that survives GUI/command
    // exit; `pnr proxy --detached` — the same for one run.
    "detached": false,
    "workerStartWaitSeconds": 15,
    "workerStopWaitSeconds": 10,
    // Extra DoH resolvers (RFC 8484) on top of netmap discovery; tailscale mode only.
    "dohSeed": [],
    // Auto-fill the DoH pool from the tailnet config; the CLI and socket are
    // chain.tailscale.cliPath / .socket.
    "dohDiscovery": {
      "enabled": true
    },
    // Chain liveness check target (CONNECT roundtrip).
    "healthCheckHost": "api.anthropic.com",
    "healthCheckPort": 443,
    // Timeouts, sec: DoH request, DoH probe, upstream dial (SOCKS5 handshake / http-mode
    // CONNECT), client header read.
    "dohTimeoutSeconds": 8,
    "dohProbeTimeoutSeconds": 4,
    "socksTimeoutSeconds": 12,
    "headerTimeoutSeconds": 30,
    // DoH pool: refresh period and cooldown of a rejected endpoint, sec.
    "dohRefreshSeconds": 600,
    "dohDeadCooldownSeconds": 300,
    // Domain for probing DoH endpoints (already routed, no side effects).
    "dohProbeName": "claude.ai",
    // Resolution cache: the response TTL is clamped to this range, sec.
    "cacheTtlMinSeconds": 60,
    "cacheTtlMaxSeconds": 3600,
    // Activity marker: mtime = time of the last proxied request; touched at most once
    // per interval (the watchdog reads it).
    "activityMarkerPath": "%APPDATA%\\PrivateNetRouting\\proxy-activity",
    "activityTouchIntervalSeconds": 60
  },

  "chain": {
    // "tailscale" (default) — the userspace sidecar (daemon + keeper + node);
    // "socks5" — the external upstream of the "socks5" section below;
    // "http" — the provided plain HTTP proxy of the "http" section below: no local proxy at
    // all, every client is pointed at chain.http.upstream, which answers HTTP CONNECT itself.
    // Applies after a restart.
    "mode": "tailscale",
    // Wait for full chain health (CONNECT roundtrip), sec; both modes.
    "healthWaitSeconds": 90,
    // Ports by convention: 18081 forward proxy, 18082 daemon HTTP, 18083 daemon SOCKS5.
    "tailscale": {
      "tailscaledPath": "C:\\Program Files\\Tailscale\\tailscaled.exe",
      "cliPath": "C:\\Program Files\\Tailscale\\tailscale.exe",
      // Statedir: the node key lives here; an empty node goes through the interactive tailnet
      // login at the first raise (the authentication page opens in the browser).
      "stateDir": "%APPDATA%\\PrivateNetRouting\\sidecar",
      // Daemon named pipe; the CLI and the DoH netmap discovery attach to it.
      "socket": "\\\\.\\pipe\\pnr-sidecar",
      // The forward proxy and the browser egress=chain dial it.
      "socksListen": "127.0.0.1:18083",
      // Its appearance = the daemon is alive.
      "httpListen": "127.0.0.1:18082",
      // "auto" — direct on tailscale 1.104.1+ (--windows-mode=dev), runas (UAC) on
      // older builds; "never"/"always" force a mode ("always" — old builds only).
      "elevation": "auto",
      // Tailnet coordination server for the first login. Empty — the machine's system-wide
      // tailscale is asked for its own (a read-only prefs read; a silent system daemon leaves
      // the public default), and the node state remembers it afterwards (every `up`
      // mentions the server the node is bound to).
      "loginServer": "",
      "daemonWaitSeconds": 15,
      "keeperCheckSeconds": 2,
      "upTimeoutSeconds": 60,
      // Hard limit of the interactive node login (the browser roundtrip of the first raise),
      // sec.
      "loginWaitSeconds": 300,
      // Hard limit of one CLI call (status, down): an unresponsive daemon's pipe must
      // not hang the operation.
      "cliTimeoutSeconds": 20,
      "uacWaitSeconds": 90
    },
    // The external trusted upstream of the socks5 mode (the name rides the CONNECT,
    // the upstream resolves it); also the browser egress=chain address there. With the
    // local proxy off (forwardProxy.enabled=false) it becomes the applications proxy
    // endpoint for everyone — it must answer HTTP CONNECT too (a mixed inbound). The
    // other modes ignore this section. The address is "IP:port" — an IP literal, a host
    // name is rejected.
    "socks5": {
      "upstream": "127.0.0.1:18083",
      // RFC 1929 credentials; both empty — no authentication. Real values live only in
      // the user config.
      "user": "",
      "password": ""
    },
    // The provided trusted HTTP proxy of the http mode: a CONNECT-capable HTTP proxy that
    // resolves the names carried by the CONNECT on its side. The local forward proxy does
    // not run in this mode at all — this address is the applications proxy endpoint for
    // everyone (both apps' flags and env, the WSL sync, the updater, the checks, the
    // browser profile), so it must be reachable from the WSL distros when the WSL sync is
    // on (loopback-only is unreachable from a distro). The other modes ignore this
    // section. The address is "IP:port" — an IP literal, a host name is rejected.
    // PLACEHOLDER: the real address — only in the user config.
    "http": {
      "upstream": "192.0.2.10:3128"
    }
  },

  // The WSL layer of the guard sync + the idle-stop WSL step; entirely optional.
  "wsl": {
    // "on" | "off" | "auto" (auto — on if WSL exists and a configured distro is
    // installed); off wins over the sync flags below.
    "mode": "auto",
    // Sync the Claude layer (the startup script + settings.json env) into every
    // configured distro.
    "syncClaude": true,
    // Sync the Codex proxy env layer (proxyEnvPath) into every configured distro.
    "syncCodex": true,
    // Distros the application works with: the guard syncs into every configured one;
    // the idle stopper stops the app host processes in every RUNNING one of them (no
    // distro is booted just for that). The name as in `wsl --list`, the user — the
    // owner of ~/.claude. Nothing is discovered automatically: fill the list in —
    // an empty list keeps the WSL layer off.
    "distros": [],
    // Startup script inside the distro (same path in all of them): refreshes the proxy
    // address (NAT gateway) on distro start.
    "startupScriptPath": "/etc/wsl.d/startup/10-claude-proxy.sh",
    // Codex proxy env snippet: exports the application proxy only to the shells Codex
    // starts (its WSL processes carry CODEX_HOME); ordinary shells stay direct.
    "proxyEnvPath": "/etc/profile.d/20-pnr-codex-proxy.sh"
  },

  // Idle auto-stop: when idle — stop the app host processes in the RUNNING configured
  // WSL distros (wsl.distros), then the chain. Armed only explicitly (the chain card
  // toggle / `pnr watchdog`); no autostart entries.
  "watchdog": {
    // Activity check interval, sec; also the marker freshness window.
    "checkSeconds": 600,
    // Arm the stopper automatically after every successful chain raise.
    "autoStart": true,
    "workerStartWaitSeconds": 15,
    "workerStopWaitSeconds": 10
  },

  // The browser profile; written once by the create dialog ("?" menu).
  "browser": {
    // "forward-proxy" (default) — the application's CONNECT proxy (or, where the local
    // proxy does not run — the http mode, or socks5 with the proxy off — the external
    // upstream itself): names resolved on the proxy side, past the ban. "chain" — the
    // chain's final egress (the sidecar's SOCKS5 listener, chain.socks5.upstream as
    // SOCKS5, chain.http.upstream as HTTP CONNECT): no application process needed, but
    // in the tailscale mode the sidecar resolves with the system resolver — ban names
    // do not open through it.
    "egress": "forward-proxy",
    // "firefox" | "chrome"; empty — the profile has not been created yet.
    "type": "",
    // Empty — looked up in the standard places at launch.
    "executablePath": "",
    "profileDir": "",
    // Empty — no desktop shortcut.
    "shortcutPath": "",
    "probeTimeoutSeconds": 5
  },

  // Direct-access guards: the managed policy, the three-layer local ban (the name
  // lists live in the claude/codex sections; the rule identifiers here — the
  // application maintains a ban with these identifiers, not a parallel one), the WSL
  // layer (the wsl section), the WinINET system proxy.
  "guard": {
    "hostsFile": "%SystemRoot%\\System32\\drivers\\etc\\hosts",
    "hostsBeginMarker": "# >>> ai-direct-ban",
    "hostsEndMarker": "# <<< ai-direct-ban",
    "hostsComment": "# AI services (Claude/OpenAI) are blocked from direct access; Claude: only through the local forward proxy",
    // DisplayName of the NRPT rule — by it the rule is found and removed.
    "nrptRuleName": "ai-direct-ban",
    "nrptComment": "Claude/OpenAI: direct access blocked; Claude — only through the local forward proxy",
    // Group of the firewall rules — by it the rules are found and removed.
    "firewallGroup": "ai-direct-ban",
    // Live ban probes: each name must be inside the ban trees but absent from the
    // hosts lists — a clean NRPT check (one per app).
    "banProbes": [ "www.anthropic.com", "www.openai.com" ]
  }
}
