{
  // Настройки интерфейса WPF-приложения (CLI всегда английский).
  // "auto" — язык системы, фолбэк английский; иначе код языка ("en", "ru").
  "ui": {
    "language": "auto",
    // Проверять на старте GUI, нет ли обновления Claude (чтение версий и журнала
    // AppX, без подъёма цепочки и UAC); при наличии — уведомление в окне и трее.
    "checkUpdatesOnStart": true
  },
  "logging": {
    // Каталог логов; переменные окружения раскрываются.
    "directory": "%LOCALAPPDATA%\\PrivateNetRouting\\logs",
    // Ротация один раз на старте процесса, не во время работы.
    "maxBytes": 1000000,
    "keep": 2
  },
  "forwardProxy": {
    // Запускать ли локальный CONNECT-прокси автоматически.
    "enabled": true,
    // Основной слушатель (клиенты подключаются сюда).
    "listen": "127.0.0.1:18082",
    // Дополнительный одноразовый бинд на шлюзе WSL NAT (vEthernet (WSL...)):
    // адрес адаптера читается на старте с повторами, мониторинга нет.
    "bindWslGateway": true,
    // SOCKS5-апстрим (userspace-sidecar): туда дозваниваемся по IP после DoH-резолва.
    "socks5Upstream": "127.0.0.1:18083",
    // Стартовый пул DoH-резолверов (RFC 8484, http://IP:PORT/dns-query).
    // ПЛЕЙСХОЛДЕРЫ: замени на свои адреса; реальные значения живут только
    // в пользовательском конфиге %APPDATA%\PrivateNetRouting\appsettings.json.
    "dohSeed": [
      "http://203.0.113.10:8480/dns-query",
      "http://203.0.113.11:8480/dns-query"
    ],
    // Автодополнение пула DoH из конфига tailnet (tailscale debug netmap через
    // именованный пайп sidecar). По умолчанию выключено: до первого живого подъёма
    // цепочки достаточно seed-списка; адрес резолверов подхватывается автоматически,
    // мёртвые отфильтровываются.
    "dohDiscovery": {
      "enabled": false,
      "cliPath": "C:\\Program Files\\Tailscale\\tailscale.exe",
      "socket": "\\\\.\\pipe\\ts-sidecar"
    },
    // Цель для проверки живости цепочки CONNECT-roundtrip'ом.
    "healthCheckHost": "api.anthropic.com",
    "healthCheckPort": 443,
    // Таймауты (сек): DoH-запрос, дозвон SOCKS5, чтение заголовка клиента.
    "dohTimeoutSeconds": 8,
    "dohProbeTimeoutSeconds": 4,
    "socksTimeoutSeconds": 12,
    "headerTimeoutSeconds": 30,
    // Пул DoH: период обновления и кулдаун отбракованного эндпоинта.
    "dohRefreshSeconds": 600,
    "dohDeadCooldownSeconds": 300,
    // Домен для пробы эндпоинтов (уже маршрутизируется, побочных эффектов нет).
    "dohProbeName": "claude.ai",
    // Кэш резолва: TTL ответа клампится в этот диапазон.
    "cacheTtlMinSeconds": 60,
    "cacheTtlMaxSeconds": 3600,
    // Маркер активности: mtime файла = время последнего проксированного запроса;
    // обновляется не чаще раза в intervalSeconds (сторож опрашивает раз в 10 мин).
    "activityMarkerPath": "%APPDATA%\\PrivateNetRouting\\proxy-activity",
    "activityTouchIntervalSeconds": 60,
    // Отладочная трассировка запросов (только для наладки).
    "verbose": false
  },
  "chain": {
    // Порты по договорённости: 18081 = HTTP демона, 18082 = forward-прокси (адрес для
    // клиента), 18083 = SOCKS5 демона. Дефолты не конфликтуют с прежней скриптовой
    // схемой; при замещении её — согласуй порты и воспользуйся кнопкой приложения
    // «прописать порты в Claude» (в разработке).
    "tailscaledPath": "C:\\Program Files\\Tailscale\\tailscaled.exe",
    "tailscaleCliPath": "C:\\Program Files\\Tailscale\\tailscaled.exe",
    // Statedir демона: здесь ключ узла. Пустой узел потребует входа в tailnet
    // (логин-сервер — ниже); существующий statedir с ключом поднимется молча.
    "stateDir": "%APPDATA%\\PrivateNetRouting\\ts-sidecar",
    "socket": "\\\\.\\pipe\\pnr-sidecar",
    "daemonSocksListen": "127.0.0.1:18083",
    "daemonHttpListen": "127.0.0.1:18081",
    "daemonWaitSeconds": 15,
    "keeperCheckSeconds": 2,
    // Координационный сервер tailnet; пусто — берётся из состояния узла (statedir).
    "loginServer": "",
    "upTimeoutSeconds": 60,
    "uacWaitSeconds": 90,
    "healthWaitSeconds": 90
  },
  "launcher": {
    // Запуск Claude Desktop через лончер (кнопка приложения или `pnr launch`):
    // проверка/подъём цепочки, затем старт с --proxy-server (адрес — forwardProxy.listen)
    // и --proxy-bypass-list (ниже). Исполняемый файл — execution alias MSIX;
    // переменные окружения раскрываются.
    "aliasPath": "%LOCALAPPDATA%\\Microsoft\\WindowsApps\\claude-desktop.exe",
    // Зоны обхода прокси: каждая попадает в bypass-list в двух формах
    // ('example.com' и '*.example.com'; localhost и приватные диапазоны добавляются сами).
    // ПЛЕЙСХОЛДЕРЫ: реальные домены — только в пользовательском конфиге
    // %APPDATA%\\PrivateNetRouting\\appsettings.json.
    "bypassDomains": [
      "corp.example.com",
      "team.example.net"
    ]
  },
  "watchdog": {
    // Автостоп по простою: раз в checkSeconds проверяется занятость Claude
    // (процессы claude*, коннекты к прокси, свежесть маркера активности);
    // при простое — остановка WSL-хоста Claude, затем цепочки. Сторож запускается
    // только явно (`pnr watchdog` / переключатель в окне приложения) и живёт,
    // пока жив запустивший процесс — в автозапуск не прописывается.
    "checkSeconds": 600,
    // Дистрибутив WSL с хостом Claude Desktop; пусто — WSL-хост не трогается.
    "wslDistro": ""
  },
  "updater": {
    // Ручное обновление Claude Desktop (MSIX) через прокси-цепочку: кнопка приложения
    // «Обновить Claude…» или `pnr update`. Проверка версий идёт ДО подъёма цепочки —
    // «нечего ставить» не поднимает ничего и не просит UAC; во время скачивания
    // держится свежим маркер активности, чтобы автостоп не погасил цепочку.
    "packageName": "Claude",
    // Хост раздачи пакетов (публичная константа; адрес ищется в журнале AppX).
    "packageHost": "downloads.claude.ai",
    // Кэш пакетов и фрагментов докачки; переменные окружения раскрываются.
    "cacheDir": "%LOCALAPPDATA%\\PrivateNetRouting\\update-cache",
    // Windows PowerShell (Get-AppxPackage/Add-AppxPackage/Get-WinEvent) — компонент ОС.
    "powerShellPath": "%WINDIR%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
    // Имя процесса Claude Desktop — закрывается перед установкой.
    "claudeProcessName": "Claude",
    // Сколько свежих событий журнала AppX просматривать при поиске адреса пакета.
    "journalMaxEvents": 400,
    // Докачка фрагментами (один поток через цепочку упирается в задержку DoH):
    "chunkBytes": 8388608,
    "parallelChunks": 6,
    "chunkRetries": 3,
    "retryDelaySeconds": 5,
    "chunkTimeoutSeconds": 1800,
    // Закрытие Claude перед установкой: ожидание самостоятельного выхода,
    // затем гашение и пауза.
    "closeWaitSeconds": 25,
    "killSettleSeconds": 3
  },
  "guard": {
    // Гарды прямого доступа: managed-политика egressProxyUrl (+disableWslSessions=0),
    // локальный бан из трёх слоёв (hosts + NRPT + firewall), env в settings.json
    // Claude Code (Windows и WSL), системный прокси WinINET. Идентификаторы правил
    // бана по умолчанию совпадают с прежней схемой (ban-ai-hosts.ps1) — приложение
    // подхватывает и ведёт уже стоящий бан, а не создаёт параллельный.
    "hostsFile": "%SystemRoot%\\System32\\drivers\\etc\\hosts",
    "hostsBeginMarker": "# >>> ai-direct-ban (ban-ai-hosts.ps1, C:\\ovpn-script)",
    "hostsEndMarker": "# <<< ai-direct-ban",
    "hostsComment": "# AI services (Claude/OpenAI) blocked from direct access; Claude: local ts-fwd proxy 127.0.0.1:8082 only",
    // Точные имена для hosts и поддеревья для NRPT — публичные домены Anthropic/OpenAI;
    // списки можно править под себя, блок/правило пересобираются при включении бана.
    "banHosts": [
      "claude.ai", "claude.com", "anthropic.com", "claudeusercontent.com",
      "claudemcpclient.com", "claudemcpcontent.com", "claude.dev", "clau.de",
      "api.anthropic.com", "console.anthropic.com", "statsig.anthropic.com",
      "downloads.claude.ai", "a.claude.ai", "assets.claude.ai", "assets-proxy.anthropic.com",
      "anthropic.qualtrics.com", "servd-anthropic-website.b-cdn.net",
      "openai.com", "chatgpt.com", "oaistatic.com", "oaiusercontent.com", "chat.com", "sora.com",
      "chatgpt.site", "oaistatsig.com", "crixet.com",
      "ab.chatgpt.com", "api.openai.com", "auth.openai.com", "platform.openai.com", "cdn.oaistatic.com",
      "openai.qualtrics.com", "chatgpt.livekit.cloud", "openai.com.cdn.cloudflare.net",
      "openaicom.imgix.net", "openaiassets.blob.core.windows.net",
      "openaicomproductionae4b.blob.core.windows.net", "openaiapi-site.azureedge.net",
      "production-openaicom-storage.azureedge.net", "openaicom-api-bdcpf8c6d2e9atf6.z01.azurefd.net"
    ],
    "banTrees": [
      "claude.ai", "claude.com", "anthropic.com", "claudeusercontent.com",
      "claudemcpclient.com", "claudemcpcontent.com", "claude.dev", "clau.de",
      "openai.com", "chatgpt.com", "oaistatic.com", "oaiusercontent.com", "chat.com", "sora.com",
      "chatgpt.site", "oaistatsig.com", "crixet.com"
    ],
    // Подсети Anthropic для firewall outbound Block (публичные константы).
    "firewallSubnets": [ "160.79.104.0/21", "2607:6bc0::/48", "2607:6bc0:11::/48" ],
    // Пробное имя поддерева anthropic.com: в hosts его нет — чистая проверка NRPT.
    "banProbeName": "www.anthropic.com",
    // settings.json Claude Code в Windows (env: HTTPS_PROXY/HTTP_PROXY/NO_PROXY).
    "claudeSettingsPath": "%USERPROFILE%\\.claude\\settings.json",
    // WSL-слой целиком опционален: mode = on | off | auto (auto — вкл, только если
    // WSL есть и хотя бы один настроенный дистрибутив установлен). По каждому
    // дистрибутиву свой выбор: sync=true — писать стартовый скрипт и settings.json,
    // false — только показывать статус. ПЛЕЙСХОЛДЕРЫ: реальные имена — только
    // в пользовательском конфиге.
    "wsl": {
      "mode": "auto",
      "distros": [
        { "name": "wsl-distro", "user": "wsl-user", "sync": true }
      ]
    },
    // Путь стартового скрипта внутри дистрибутива (одинаков во всех).
    "wslStartupScript": "/etc/wsl.d/startup/10-claude-proxy.sh",
    // Дополнительные записи обхода системного прокси (локальные адреса и приватные
    // диапазоны добавляются сами; корпоративные домены — из launcher.bypassDomains).
    "systemProxyExtraBypass": [ "*.ru", "*.su", "*.by", "*.kz" ]
  }
}
