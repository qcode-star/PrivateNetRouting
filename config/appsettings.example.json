{
  // WPF application UI settings (the CLI is always English).
  // "auto" — system language, English fallback; otherwise a language code ("en", "ru").
  "ui": {
    "language": "auto",
    // On GUI start, check whether a Claude update is available (reads versions and the
    // AppX journal, no chain bring-up and no UAC); if there is one — a notice in the window and tray.
    "checkUpdatesOnStart": true,
    // One check at GUI start whether an update of the application itself is available (GitHub
    // releases of the repository, no chain and no UAC); if there is one — an offer to open the
    // releases page.
    "checkAppUpdatesOnStart": true,
    // Main-window cards: false — collapsed to one compact row (chain: overall status +
    // Raise/Stop; guards: overall status + Enable all/Disable all). The choice survives restarts.
    "chainCardExpanded": true,
    "guardsCardExpanded": true
  },
  "logging": {
    // Log directory; environment variables are expanded.
    "directory": "%LOCALAPPDATA%\\PrivateNetRouting\\logs",
    // Minimum record level: "debug" | "info" | "warn" | "error".
    // Default is "info" — one-off events (start/stop/auto-stop) without noise; "debug" is
    // for troubleshooting: per-request proxy tracing, watchdog and DoH pool timer ticks,
    // chain bring-up steps. An unknown value = "info".
    "level": "info",
    // Rotation threshold: at start and before the next record into an overgrown file.
    "maxBytes": 1000000,
    "keep": 2
  },
  "forwardProxy": {
    // Whether the `pnr proxy` command may start the local CONNECT proxy. The GUI does not raise
    // the proxy on open: it comes up as part of the chain (chain up, launches), regardless of
    // this flag.
    "enabled": true,
    // Main listener (clients connect here).
    "listen": "127.0.0.1:18081",
    // Extra one-shot bind on the WSL NAT gateway (vEthernet (WSL...)):
    // the adapter address is read at start with retries, there is no monitoring.
    "bindWslGateway": true,
    // Run the proxy in a separate detached worker (<own exe> --proxy-worker) that survives
    // the command/GUI exit: chain up brings the worker up, chain down stops it, GUI exit does
    // not kill it. Disabled — the proxy lives in the GUI/command process. The
    // `pnr proxy --detached` flag enables this mode for a single run without editing the config.
    "detached": false,
    // Waiting for the detached worker: how many seconds to wait for its listener after start
    // and for the port to be released after stop.
    "workerStartWaitSeconds": 15,
    "workerStopWaitSeconds": 10,
    // SOCKS5 upstream of the socks5 mode: the external trusted proxy (IP:port;
    // authentication is configured in socks5UpstreamUser/Password) — the target name rides
    // the CONNECT and the upstream resolves it on its side. In the tailscale mode this field
    // is not used: the proxy dials the sidecar's own listener (chain.daemonSocksListen below)
    // by IP after DoH resolution.
    "socks5Upstream": "127.0.0.1:18083",
    // Credentials for an external proxy that requires them (RFC 1929 username/password);
    // both empty — no authentication (the tailscale sidecar needs none). They live only in the
    // user config; the repository never receives real values.
    "socks5UpstreamUser": "",
    "socks5UpstreamPassword": "",
    // Optional extra DoH resolvers (RFC 8484, "http(s)://IP:PORT/dns-query") on top of netmap
    // discovery. Empty by default: in the tailscale mode the resolvers are picked up from the
    // tailnet config automatically. Only the tailscale mode uses DoH.
    "dohSeed": [],
    // Auto-fill the DoH pool from the tailnet config (tailscale debug netmap through the
    // sidecar named pipe): any DoH resolvers of the tailnet DNS config — http and https, by IP
    // or by name. On by default; the resolver addresses are picked up automatically, dead
    // endpoints are filtered out.
    "dohDiscovery": {
      "enabled": true,
      "cliPath": "C:\\Program Files\\Tailscale\\tailscale.exe",
      "socket": "\\\\.\\pipe\\pnr-sidecar"
    },
    // Target for the chain liveness check via CONNECT roundtrip.
    "healthCheckHost": "api.anthropic.com",
    "healthCheckPort": 443,
    // Timeouts (sec): DoH request, SOCKS5 dial, reading the client header.
    "dohTimeoutSeconds": 8,
    "dohProbeTimeoutSeconds": 4,
    "socksTimeoutSeconds": 12,
    "headerTimeoutSeconds": 30,
    // DoH pool: refresh period and cooldown of a rejected endpoint.
    "dohRefreshSeconds": 600,
    "dohDeadCooldownSeconds": 300,
    // Domain for probing endpoints (already routed, no side effects).
    "dohProbeName": "claude.ai",
    // Resolution cache: the response TTL is clamped to this range.
    "cacheTtlMinSeconds": 60,
    "cacheTtlMaxSeconds": 3600,
    // Activity marker: the file mtime is the time of the last proxied request;
    // updated no more than once per intervalSeconds (the watchdog polls every 10 min).
    "activityMarkerPath": "%APPDATA%\\PrivateNetRouting\\proxy-activity",
    "activityTouchIntervalSeconds": 60
  },
  "chain": {
    // What carries the traffic: "tailscale" (default) — the userspace sidecar below
    // (daemon + keeper + node); "socks5" — an external SOCKS5 proxy from
    // forwardProxy.socks5Upstream: every tailscale step is skipped, the chain card shows a
    // single egress check instead. A change applies after a restart.
    "mode": "tailscale",
    // Ports by convention: 18081 = forward proxy (the address for the client),
    // 18082 = daemon HTTP, 18083 = daemon SOCKS5.
    "tailscaledPath": "C:\\Program Files\\Tailscale\\tailscaled.exe",
    "tailscaleCliPath": "C:\\Program Files\\Tailscale\\tailscale.exe",
    // Daemon statedir: the node key lives here. An empty node will require a tailnet login
    // (login server — below); an existing statedir with a key comes up silently.
    "stateDir": "%APPDATA%\\PrivateNetRouting\\sidecar",
    "socket": "\\\\.\\pipe\\pnr-sidecar",
    "daemonSocksListen": "127.0.0.1:18083",
    "daemonHttpListen": "127.0.0.1:18082",
    // How the daemon start/stop is elevated: "auto" (default) — directly on tailscale 1.104.1+
    // (--windows-mode=dev, the pipe is owned by the user), through the elevated runas copy (UAC)
    // on older builds; "never"/"always" force one of the modes ("always" is only for tailscale
    // older than 1.104.1 — newer daemons reject a custom socket without the dev flag even elevated).
    "daemonElevation": "auto",
    "daemonWaitSeconds": 15,
    "keeperCheckSeconds": 2,
    // Tailnet coordination server; empty — taken from the node state (statedir).
    "loginServer": "",
    "upTimeoutSeconds": 60,
    // Hard limit of one tailscale CLI call (status, down): a daemon that stopped answering
    // its pipe must not hang the whole operation — the call fails and the process is killed.
    // "up" is bounded by its own --timeout (upTimeoutSeconds) plus a small margin on top.
    "cliTimeoutSeconds": 20,
    "uacWaitSeconds": 90,
    "healthWaitSeconds": 90
  },
  "launcher": {
    // Launch Claude Desktop through the launcher (application button or `pnr launch`):
    // check/bring up the chain, then start with --proxy-server (address — forwardProxy.listen)
    // and --proxy-bypass-list (below). The executable is an MSIX execution alias;
    // environment variables are expanded.
    "aliasPath": "%LOCALAPPDATA%\\Microsoft\\WindowsApps\\claude-desktop.exe",
    // Proxy bypass zones: each one goes into the bypass list in two forms
    // ('example.com' and '*.example.com'; localhost and private ranges are added automatically).
    // PLACEHOLDERS: real domains — only in the user config
    // %APPDATA%\\PrivateNetRouting\\appsettings.json.
    "bypassDomains": [
      "corp.example.com",
      "team.example.net"
    ]
  },
  "browser": {
    // Browser launcher with an isolated profile and its own proxy (application button,
    // shortcut `--launch-browser` or `pnr browser`): the browser's system settings
    // are not touched. Firefox — a separate profile with user.js (rewritten on
    // every launch), Chromium-like — via command-line flags.
    // Which browser to launch: "firefox" | "chromium" (Edge, Chrome, ...;
    // an unknown value — firefox).
    "type": "firefox",
    // Address opened in the browser.
    "url": "https://claude.ai",
    // Private window: Firefox -private-window / Chromium --incognito.
    "private": false,
    // Top-level domains that go direct, bypassing the proxy (*.tld): local sites
    // must not leave through a foreign exit. The bypass zone domains are shared with the Claude
    // launcher (launcher.bypassDomains); there is no separate list here.
    "directTlds": ["ru", "su", "by", "kz"],
    "firefox": {
      // firefox.exe; if not found — fallback to Program Files (x86).
      // Environment variables are expanded.
      "path": "%ProgramFiles%\\Mozilla Firefox\\firefox.exe",
      // Isolated profile directory (cookies and logins live only here).
      "profileDir": "%APPDATA%\\PrivateNetRouting\\browser\\ff-profile"
    },
    "chromium": {
      // A browser of the Chromium-like family; if not found — fallback to Program Files.
      "path": "%ProgramFiles(x86)%\\Microsoft\\Edge\\Application\\msedge.exe",
      // Isolated profile directory (--user-data-dir; required — a running
      // instance ignores command-line flags).
      "profileDir": "%APPDATA%\\PrivateNetRouting\\browser\\chromium-profile"
    }
  },
  "watchdog": {
    // Idle auto-stop: every checkSeconds the Claude activity is checked
    // (claude* processes, connections to the proxy, activity marker freshness);
    // when idle — stop the WSL Claude host, then the chain. The stopper starts
    // only explicitly (`pnr watchdog` / the toggle in the chain card): the GUI
    // starts a detached worker (--watchdog-worker) that keeps working after the
    // application is closed and switches itself off after the idle stop — it is
    // not registered for autostart.
    "checkSeconds": 600,
    // Arm the stopper automatically after every successful chain raise
    // (the window button, the Claude/browser launch, `pnr chain up`).
    "autoStart": true,
    // WSL distro with the Claude Desktop host; empty — the WSL host is not touched.
    "wslDistro": "",
    // Waiting for the detached worker: to appear in the process list after the
    // launch, and to disappear after a kill.
    "workerStartWaitSeconds": 15,
    "workerStopWaitSeconds": 10
  },
  "updater": {
    // Manual Claude Desktop (MSIX) update through the proxy chain: the application button
    // "Update Claude…" or `pnr update`. The version check runs BEFORE the chain bring-up —
    // "nothing to install" brings up nothing and asks for no UAC; during the download
    // the activity marker is kept fresh so auto-stop does not shut the chain down.
    "packageName": "Claude",
    // Package distribution host (public constant; the update feed and journal addresses are
    // filtered by it).
    "packageHost": "downloads.claude.ai",
    // Claude's own update feed (public constant — the same endpoint its built-in updater
    // polls): asking it returns the latest .msix address at once, through the live chain,
    // without waiting until the built-in updater leaves one in the AppX journal (that stays
    // as the fallback). Empty — do not ask the feed.
    "updateFeedUrl": "https://api.anthropic.com/api/desktop/win32/x64/msix/update",
    // Timeout of one update feed request, sec.
    "feedTimeoutSeconds": 15,
    // Cache of packages and download fragments; environment variables are expanded.
    "cacheDir": "%LOCALAPPDATA%\\PrivateNetRouting\\update-cache",
    // Windows PowerShell (Get-AppxPackage/Add-AppxPackage/Get-WinEvent) — an OS component.
    "powerShellPath": "%WINDIR%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
    // Claude Desktop process name — closed before installation.
    "claudeProcessName": "Claude",
    // How many recent AppX journal events to scan when looking up the package address.
    "journalMaxEvents": 400,
    // Chunked download (a single thread through the chain hits the DoH latency):
    "chunkBytes": 8388608,
    "parallelChunks": 6,
    "chunkRetries": 3,
    "retryDelaySeconds": 5,
    "chunkTimeoutSeconds": 1800,
    // Closing Claude before installation: wait for it to exit on its own,
    // then kill it and pause.
    "closeWaitSeconds": 25,
    "killSettleSeconds": 3
  },
  "guard": {
    // Direct-access guards: the managed policy egressProxyUrl (+disableWslSessions=0),
    // a local ban of three layers (hosts + NRPT + firewall), env in Claude Code
    // settings.json (Windows and WSL), the WinINET system proxy. The ban rule
    // identifiers are configurable: the application looks up and maintains a ban with
    // these identifiers instead of creating a parallel one.
    "hostsFile": "%SystemRoot%\\System32\\drivers\\etc\\hosts",
    "hostsBeginMarker": "# >>> ai-direct-ban",
    "hostsEndMarker": "# <<< ai-direct-ban",
    "hostsComment": "# AI services (Claude/OpenAI) are blocked from direct access; Claude: only through the local forward proxy",
    // Exact names for hosts and subtrees for NRPT — public Anthropic/OpenAI domains;
    // the lists can be edited to taste, the block/rule are rebuilt when the ban is enabled.
    "banHosts": [
      "claude.ai", "claude.com", "anthropic.com", "claudeusercontent.com",
      "claudemcpclient.com", "claudemcpcontent.com", "claude.dev", "clau.de",
      "api.anthropic.com", "console.anthropic.com", "statsig.anthropic.com",
      "downloads.claude.ai", "a.claude.ai", "assets.claude.ai", "assets-proxy.anthropic.com",
      "anthropic.qualtrics.com", "servd-anthropic-website.b-cdn.net",
      "openai.com", "chatgpt.com", "oaistatic.com", "oaiusercontent.com", "chat.com", "sora.com",
      "chatgpt.site", "oaistatsig.com", "crixet.com",
      "ab.chatgpt.com", "api.openai.com", "auth.openai.com", "platform.openai.com", "cdn.oaistatic.com",
      "openai.qualtrics.com", "chatgpt.livekit.cloud", "openai.com.cdn.cloudflare.net",
      "openaicom.imgix.net", "openaiassets.blob.core.windows.net",
      "openaicomproductionae4b.blob.core.windows.net", "openaiapi-site.azureedge.net",
      "production-openaicom-storage.azureedge.net", "openaicom-api-bdcpf8c6d2e9atf6.z01.azurefd.net"
    ],
    "banTrees": [
      "claude.ai", "claude.com", "anthropic.com", "claudeusercontent.com",
      "claudemcpclient.com", "claudemcpcontent.com", "claude.dev", "clau.de",
      "openai.com", "chatgpt.com", "oaistatic.com", "oaiusercontent.com", "chat.com", "sora.com",
      "chatgpt.site", "oaistatsig.com", "crixet.com"
    ],
    // Anthropic subnets for the firewall outbound Block (public constants).
    "firewallSubnets": [ "160.79.104.0/21", "2607:6bc0::/48", "2607:6bc0:11::/48" ],
    // Probe subtree name anthropic.com: it is absent from hosts — a clean NRPT check.
    "banProbeName": "www.anthropic.com",
    // settings.json of Claude Code on Windows (env: HTTPS_PROXY/HTTP_PROXY/NO_PROXY).
    "claudeSettingsPath": "%USERPROFILE%\\.claude\\settings.json",
    // The WSL layer is entirely optional: mode = on | off | auto (auto — on only if
    // WSL exists and at least one configured distro is installed). Each distro
    // has its own choice: sync=true — write the startup script and settings.json,
    // false — only show the status. PLACEHOLDERS: real names — only
    // in the user config.
    "wsl": {
      "mode": "auto",
      "distros": [
        { "name": "wsl-distro", "user": "wsl-user", "sync": true }
      ]
    },
    // Path of the startup script inside the distro (the same in all of them).
    "wslStartupScript": "/etc/wsl.d/startup/10-claude-proxy.sh",
    // Extra system proxy bypass entries (local addresses and private
    // ranges are added automatically; corporate domains — from launcher.bypassDomains).
    "systemProxyExtraBypass": [ "*.ru", "*.su", "*.by", "*.kz" ]
  }
}