{
  "logging": {
    // Каталог логов; переменные окружения раскрываются.
    "directory": "%LOCALAPPDATA%\\PrivateNetRouting\\logs",
    // Ротация один раз на старте процесса, не во время работы.
    "maxBytes": 1000000,
    "keep": 2
  },
  "forwardProxy": {
    // Запускать ли локальный CONNECT-прокси автоматически.
    "enabled": true,
    // Основной слушатель (клиенты подключаются сюда).
    "listen": "127.0.0.1:8082",
    // Дополнительный одноразовый бинд на шлюзе WSL NAT (vEthernet (WSL...)):
    // адрес адаптера читается на старте с повторами, мониторинга нет.
    "bindWslGateway": true,
    // SOCKS5-апстрим (userspace-sidecar): туда дозваниваемся по IP после DoH-резолва.
    "socks5Upstream": "127.0.0.1:1055",
    // Стартовый пул DoH-резолверов (RFC 8484, http://IP:PORT/dns-query).
    // ПЛЕЙСХОЛДЕРЫ: замени на свои адреса; реальные значения живут только
    // в пользовательском конфиге %APPDATA%\PrivateNetRouting\appsettings.json.
    "dohSeed": [
      "http://203.0.113.10:8480/dns-query",
      "http://203.0.113.11:8480/dns-query"
    ],
    // Автодополнение пула DoH из конфига tailnet (tailscale debug netmap через
    // именованный пайп sidecar). Выключено, пока модуль ChainSupervisor не введён
    // в строй; адрес резолверов подхватывается автоматически, мёртвые отфильтровываются.
    "dohDiscovery": {
      "enabled": false,
      "cliPath": "C:\\Program Files\\Tailscale\\tailscale.exe",
      "socket": "\\\\.\\pipe\\ts-sidecar"
    },
    // Цель для проверки живости цепочки CONNECT-roundtrip'ом.
    "healthCheckHost": "example.com",
    "healthCheckPort": 443,
    // Таймауты (сек): DoH-запрос, дозвон SOCKS5, чтение заголовка клиента.
    "dohTimeoutSeconds": 8,
    "dohProbeTimeoutSeconds": 4,
    "socksTimeoutSeconds": 12,
    "headerTimeoutSeconds": 30,
    // Пул DoH: период обновления и кулдаун отбракованного эндпоинта.
    "dohRefreshSeconds": 600,
    "dohDeadCooldownSeconds": 300,
    // Домен для пробы эндпоинтов (уже маршрутизируется, побочных эффектов нет).
    "dohProbeName": "example.com",
    // Кэш резолва: TTL ответа клампится в этот диапазон.
    "cacheTtlMinSeconds": 60,
    "cacheTtlMaxSeconds": 3600,
    // Маркер активности: mtime файла = время последнего проксированного запроса;
    // обновляется не чаще раза в intervalSeconds (сторож опрашивает раз в 10 мин).
    "activityMarkerPath": "%APPDATA%\\PrivateNetRouting\\proxy-activity",
    "activityTouchIntervalSeconds": 60,
    // Отладочная трассировка запросов (только для наладки).
    "verbose": false
  }
}
