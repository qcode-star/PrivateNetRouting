<Application x:Class="PrivateNetRouting.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="Brush.Window" Color="#1F1E1D"/>
        <SolidColorBrush x:Key="Brush.Card" Color="#2A2826"/>
        <SolidColorBrush x:Key="Brush.CardBorder" Color="#3A3733"/>
        <SolidColorBrush x:Key="Brush.Text" Color="#E8E6E3"/>
        <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A8A29E"/>
        <SolidColorBrush x:Key="Brush.Accent" Color="#D97757"/>
        <SolidColorBrush x:Key="Brush.AccentHover" Color="#E28A6B"/>
        <SolidColorBrush x:Key="Brush.Ok" Color="#7CB97C"/>
        <SolidColorBrush x:Key="Brush.Bad" Color="#D96B6B"/>
        <SolidColorBrush x:Key="Brush.Idle" Color="#6B6862"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#5A4A42"/>
                                <Setter Property="Foreground" Value="#B8AFA9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3A3733"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4641"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
