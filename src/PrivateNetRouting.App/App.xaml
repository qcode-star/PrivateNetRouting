<Application x:Class="PrivateNetRouting.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
    <!--
        Design tokens and control styles for the whole application. Windows reference these keys
        and never hardcode a colour, size or radius: a palette or type change is an edit here.
        Layers:
          * surfaces    - warm neutrals, four steps: window, band, card, code
          * text        - three weights of the warm off-white plus the accent/state colours
          * type        - Segoe UI Variable for the interface, Cascadia Mono for machine data
          * controls    - Button (three tiers + an accent variant), CheckBox, ComboBox, TextBox,
                          ProgressBar, ListBox, ScrollBar, ToolTip, Card
        Localized strings are always DynamicResource (the dictionary is swapped on the fly);
        tokens are StaticResource (fixed at load).
    -->
    <Application.Resources>
        <!-- ============================= Surfaces ============================= -->
        <SolidColorBrush x:Key="Brush.Window" Color="#1B1A19"/>
        <SolidColorBrush x:Key="Brush.Band" Color="#232120"/>
        <SolidColorBrush x:Key="Brush.Card" Color="#262421"/>
        <SolidColorBrush x:Key="Brush.CardBorder" Color="#383530"/>
        <SolidColorBrush x:Key="Brush.Hairline" Color="#2E2C29"/>
        <SolidColorBrush x:Key="Brush.Code" Color="#151413"/>

        <!-- =============================== Text ============================== -->
        <SolidColorBrush x:Key="Brush.Text" Color="#EDEBE8"/>
        <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A9A39D"/>
        <SolidColorBrush x:Key="Brush.TextMuted" Color="#969089"/>

        <!-- ============================= Accent ============================== -->
        <SolidColorBrush x:Key="Brush.Accent" Color="#D97757"/>
        <SolidColorBrush x:Key="Brush.AccentHover" Color="#E58A69"/>
        <SolidColorBrush x:Key="Brush.AccentPress" Color="#C4654B"/>
        <SolidColorBrush x:Key="Brush.AccentEdge" Color="#6B4636"/>
        <SolidColorBrush x:Key="Brush.AccentSoft" Color="#33241D"/>
        <SolidColorBrush x:Key="Brush.OnAccent" Color="#241F1D"/>

        <!-- Codex/OpenAI brand accent: the identity colour of the Launch Codex action — the same
             role the Claude accent plays on the other side of the launch row (OpenAI green) -->
        <SolidColorBrush x:Key="Brush.Codex" Color="#10A37F"/>
        <SolidColorBrush x:Key="Brush.CodexHover" Color="#25B592"/>
        <SolidColorBrush x:Key="Brush.CodexPress" Color="#0B8266"/>
        <SolidColorBrush x:Key="Brush.CodexEdge" Color="#155E4C"/>
        <SolidColorBrush x:Key="Brush.CodexSoft" Color="#12251F"/>

        <!-- ======================== State and surfaces ====================== -->
        <!-- The palette is tuned: body text is well over 4.5:1 on its surface, and every colour
             that carries a state word is above 4.5:1 as text — Brush.Idle never is: it is for
             markers and links, and a word takes Brush.TextMuted instead. -->
        <SolidColorBrush x:Key="Brush.Ok" Color="#7CB97C"/>
        <SolidColorBrush x:Key="Brush.Warn" Color="#E0A83E"/>
        <SolidColorBrush x:Key="Brush.Bad" Color="#E07C7C"/>
        <SolidColorBrush x:Key="Brush.Idle" Color="#6B6862"/>
        <SolidColorBrush x:Key="Brush.FocusRing" Color="#F2B79E"/>
        <SolidColorBrush x:Key="Brush.Control" Color="#332F2B"/>
        <SolidColorBrush x:Key="Brush.ControlHover" Color="#3D3833"/>
        <SolidColorBrush x:Key="Brush.ControlPress" Color="#2A2724"/>
        <SolidColorBrush x:Key="Brush.ControlBorder" Color="#423D37"/>

        <!-- ============================= Flags =============================== -->
        <!-- Identity colours of the drawn language flags (LanguageFlags): the flags' own colours,
             not theme tokens — a palette change does not touch them -->
        <SolidColorBrush x:Key="Brush.Flag.White" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Brush.Flag.UnionBlue" Color="#012169"/>
        <SolidColorBrush x:Key="Brush.Flag.UnionRed" Color="#C8102E"/>
        <SolidColorBrush x:Key="Brush.Flag.RussiaBlue" Color="#0039A6"/>
        <SolidColorBrush x:Key="Brush.Flag.RussiaRed" Color="#D52B1E"/>

        <!-- ============================ Typography =========================== -->
        <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
        <sys:Double x:Key="Font.Title">20</sys:Double>
        <sys:Double x:Key="Font.Section">15</sys:Double>
        <sys:Double x:Key="Font.Body">13</sys:Double>
        <sys:Double x:Key="Font.Caption">12</sys:Double>

        <!-- ============================== Metrics ============================ -->
        <sys:Double x:Key="Space.XS">4</sys:Double>
        <sys:Double x:Key="Space.S">8</sys:Double>
        <sys:Double x:Key="Space.M">16</sys:Double>
        <sys:Double x:Key="Space.L">24</sys:Double>
        <CornerRadius x:Key="Radius.Card">8</CornerRadius>
        <CornerRadius x:Key="Radius.Control">6</CornerRadius>
        <Thickness x:Key="Pad.Card">20</Thickness>
        <Thickness x:Key="Gap.Card">0,12,0,0</Thickness>
        <Thickness x:Key="Pad.Button">16,0</Thickness>

        <!-- ========================= Text block styles ======================= -->
        <Style x:Key="Text.Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Title}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>
        <Style x:Key="Text.Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Section}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        </Style>
        <Style x:Key="Text.Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        </Style>
        <Style x:Key="Text.Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
        </Style>
        <Style x:Key="Text.Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        </Style>
        <!-- Machine data: addresses, paths, counters, versions, log lines -->
        <Style x:Key="Text.Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="Text.Metric" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
            <Setter Property="FontSize" Value="{StaticResource Font.Section}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        </Style>

        <!-- ============================== Button ============================= -->
        <!--
            Three tiers: Button (the one accent action of a row), SecondaryButton (a real but
            non-primary action), GhostButton (read-only or dismissal) and AccentGhostButton
            (a constructive action that is not the row's primary one). Every tier keeps the
            same two-tone focus ring: a ring 3 px outside the fill, so it stays visible on
            both a filled and a transparent button.
        -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="{StaticResource Pad.Button}"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent"/>
                            <Border x:Name="Face" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Control}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.AccentPress}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3A2F29"/>
                                <Setter Property="Foreground" Value="#8C817A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Brush.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.ControlHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.ControlPress}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource Brush.ControlPress}"/>
                    <Setter Property="Foreground" Value="#78716B"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The Codex/OpenAI brand primary: the same filled shape as the implicit Button, with
             the Codex accent brushes. The template is repeated because the base one hardcodes
             the Claude accent in its hover/press triggers. -->
        <Style x:Key="CodexButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Brush.Codex}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent"/>
                            <Border x:Name="Face" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Control}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.CodexHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.CodexPress}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1E2E29"/>
                                <Setter Property="Foreground" Value="#8C817A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.ControlHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.ControlPress}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#6A645E"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Hairline}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentGhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentEdge}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.ControlPress}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#7A6660"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Hairline}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small square ghost button for icon-only controls (the card collapse chevron);
             the icon inherits the foreground, so the hover tiers of GhostButton apply to it -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>

        <!-- =============================== Card ============================== -->
        <!-- Stage markers of the rails (see StepRail.cs): the shape adds to the colour, never colour alone -->
        <Geometry x:Key="Mark.Check">M 2,6.2 L 5,9.4 L 10,3</Geometry>
        <Geometry x:Key="Mark.Cross">M 3,3.4 L 9,9.4 M 9,3.4 L 3,9.4</Geometry>
        <!-- Card collapse/expand chevrons: the arrow shows where the card goes, the tooltip carries the word -->
        <Geometry x:Key="Mark.Chevron.Down">M 2.5,4.75 L 7,9.25 L 11.5,4.75</Geometry>
        <Geometry x:Key="Mark.Chevron.Up">M 2.5,8.25 L 7,3.75 L 11.5,8.25</Geometry>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
            <Setter Property="Padding" Value="{StaticResource Pad.Card}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ============================= CheckBox ============================ -->
        <Style x:Key="CheckGlyph" TargetType="Path">
            <Setter Property="Data" Value="M 3.5,8.5 L 7,12 L 13,5"/>
            <Setter Property="Stroke" Value="{StaticResource Brush.OnAccent}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <Border x:Name="Ring" Margin="-3" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent"/>
                                <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                                        Background="{StaticResource Brush.Control}"
                                        BorderBrush="{StaticResource Brush.ControlBorder}">
                                    <Path x:Name="Check" Style="{StaticResource CheckGlyph}" Visibility="Collapsed"/>
                                </Border>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.AccentEdge}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                <Setter TargetName="Box" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================== ComboBox =========================== -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Face" Background="{StaticResource Brush.Control}"
                                BorderBrush="{StaticResource Brush.ControlBorder}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}">
                            <Path x:Name="Chevron" Data="M 0,0 L 4.5,4.5 L 9,0" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource Brush.ControlHover}"/>
                                <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MaxDropDownHeight" Value="280"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Style="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent"
                                    IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{StaticResource Brush.Band}" BorderBrush="{StaticResource Brush.ControlBorder}"
                                        BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer Margin="4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource Brush.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================== TextBox ============================ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Brush.Code}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Brush.TextMuted}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ ProgressBar ========================== -->
        <!-- Determinate: the fill grows from the left. Indeterminate: the track breathes instead of
             a marquee, which stays honest at any window width. -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="Background" Value="{StaticResource Brush.ControlPress}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Stretch"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="Pulse">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.25" To="0.9" Duration="0:0:1.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Pulse"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Log list ============================= -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Brush.Code}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Card}">
                            <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Face" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource Brush.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Brush.AccentEdge}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Scroll bars ========================== -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Face" Background="{StaticResource Brush.ControlBorder}" CornerRadius="4" Margin="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource Brush.TextMuted}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="14"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ========================== Context menu =========================== -->
        <!-- The help menu of the header "?" button and any other popup menu: the same band
             surface as the combo dropdown, items as flat rows (no submenus anywhere). -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource Brush.Band}"
                                BorderBrush="{StaticResource Brush.ControlBorder}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}" Margin="6" Padding="4">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="4" Padding="10,8">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource Brush.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="{StaticResource Brush.Hairline}" Margin="8,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ ToolTip ============================= -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource Brush.Band}" BorderBrush="{StaticResource Brush.ControlBorder}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="10,7"
                                MaxWidth="460">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>