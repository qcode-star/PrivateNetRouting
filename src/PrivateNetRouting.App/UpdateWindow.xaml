<Window x:Class="PrivateNetRouting.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Claude Desktop"
        Width="660" Height="560" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header and a monotonic elapsed counter (freezes in the terminal state) -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubHeaderText" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="ElapsedText" HorizontalAlignment="Right" VerticalAlignment="Top"
                       FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}"/>
        </Grid>

        <!-- Steps, detail line, hint -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardBorder}"
                BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="StepsPanel" Grid.Row="0"/>
                <TextBlock x:Name="DetailText" Grid.Row="1" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextSecondary}" Margin="0,14,0,0"/>
                <TextBlock x:Name="HintText" Grid.Row="2" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Idle}" Margin="0,6,0,0"/>
            </Grid>
        </Border>

        <ProgressBar x:Name="Progress" Grid.Row="2" Height="6" Minimum="0" Maximum="100"
                     Margin="0,14,0,0" Foreground="{StaticResource Brush.Accent}"
                     Background="{StaticResource Brush.Card}" BorderThickness="0"/>

        <!-- Manual address field: expands when the journal has no fresh URL -->
        <StackPanel x:Name="UrlPanel" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="UrlLabel" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}"/>
            <DockPanel Margin="0,6,0,0">
                <Button x:Name="BtnContinueUrl" DockPanel.Dock="Right" MinWidth="150" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="OnContinueWithUrl"/>
                <TextBox x:Name="UrlBox" VerticalContentAlignment="Center" Padding="6,4"/>
            </DockPanel>
        </StackPanel>

        <!-- Buttons; availability — by phase (installation is not interrupted) -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
            <Button x:Name="BtnStop" MinWidth="110" Style="{StaticResource SecondaryButton}" Click="OnStop"/>
            <Button x:Name="BtnLog" MinWidth="110" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="OnOpenLog"/>
            <Button x:Name="BtnInstallNow" MinWidth="130" Margin="8,0,0,0" Visibility="Collapsed" Click="OnInstallNow"/>
            <Button x:Name="BtnDefer" MinWidth="110" Margin="8,0,0,0" Visibility="Collapsed" Click="OnDefer"/>
            <Button x:Name="BtnRetry" MinWidth="110" Margin="8,0,0,0" Visibility="Collapsed" Click="OnRetry"/>
            <Button x:Name="BtnLaunch" MinWidth="130" Margin="8,0,0,0" Visibility="Collapsed" Click="OnLaunchClaude"/>
            <Button x:Name="BtnClose" MinWidth="110" Margin="8,0,0,0" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
