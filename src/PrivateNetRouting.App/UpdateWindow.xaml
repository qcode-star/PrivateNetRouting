<Window x:Class="PrivateNetRouting.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Claude Desktop"
        Width="680" Height="400" MinWidth="580" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Body}"
        SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header and a monotonic elapsed counter (freezes in the terminal state) -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource Text.Title}"/>
                <TextBlock x:Name="SubHeaderText" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="ElapsedText" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right"
                       VerticalAlignment="Top"/>
        </Grid>

        <!-- Phases and the line that explains the current one; the card hugs its content -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="StepsPanel" Grid.Row="0"/>
                <TextBlock x:Name="DetailText" Grid.Row="1" Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap" Margin="0,14,0,0"/>
                <TextBlock x:Name="HintText" Grid.Row="2" Style="{StaticResource Text.Note}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
            </Grid>
        </Border>

        <!-- Download and install progress: the bar plus the percentage while it is determinate -->
        <Grid x:Name="ProgressArea" Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" Grid.Column="0" Minimum="0" Maximum="100" VerticalAlignment="Center"/>
            <TextBlock x:Name="ProgressText" Grid.Column="1" Style="{StaticResource Text.Mono}" MinWidth="44"
                       TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <!-- Manual address field: expands when the journal has no fresh URL -->
        <StackPanel x:Name="UrlPanel" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="UrlLabel" Style="{StaticResource Text.Caption}"/>
            <DockPanel Margin="0,6,0,0">
                <Button x:Name="BtnContinueUrl" DockPanel.Dock="Right" MinWidth="160" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="OnContinueWithUrl"/>
                <TextBox x:Name="UrlBox"/>
            </DockPanel>
        </StackPanel>

        <!-- Buttons; availability — by phase (installation is not interrupted).
             Wrapped, so a narrow window reflows the row instead of clipping it. -->
        <WrapPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnStop" MinWidth="110" Style="{StaticResource SecondaryButton}" Click="OnStop"/>
            <Button x:Name="BtnLog" MinWidth="110" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="OnOpenLog"/>
            <Button x:Name="BtnInstallNow" MinWidth="140" Margin="8,0,0,0" Visibility="Collapsed" Click="OnInstallNow"/>
            <Button x:Name="BtnDefer" MinWidth="110" Margin="8,0,0,0" Visibility="Collapsed"
                    Style="{StaticResource SecondaryButton}" Click="OnDefer"/>
            <Button x:Name="BtnRetry" MinWidth="110" Margin="8,0,0,0" Visibility="Collapsed"
                    Style="{StaticResource SecondaryButton}" Click="OnRetry"/>
            <Button x:Name="BtnLaunch" MinWidth="140" Margin="8,0,0,0" Visibility="Collapsed"
                    Style="{StaticResource SecondaryButton}" Click="OnLaunchClaude"/>
            <Button x:Name="BtnClose" MinWidth="110" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="OnCloseClick"/>
        </WrapPanel>
    </Grid>
</Window>