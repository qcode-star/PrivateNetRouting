<Window x:Class="PrivateNetRouting.App.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics"
        Width="780" Height="620" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Body}"
        SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: what the window shows on the left, what it can do on the right —
             separate columns, so a long title and a busy status never overlap -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeaderText" Style="{StaticResource Text.Title}" VerticalAlignment="Center"
                       Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                           Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                <Button x:Name="BtnRefresh" MinWidth="110" Click="OnRefresh"/>
                <Button x:Name="BtnOpenLogs" MinWidth="140" Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                        Click="OnOpenLogs"/>
            </StackPanel>
        </Grid>

        <!-- Summary: sections of "name: value" lines, the value carrying the mark of its state -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SectionsPanel" Margin="0,0,8,0"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
