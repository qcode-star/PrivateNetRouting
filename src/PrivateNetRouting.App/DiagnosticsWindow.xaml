<Window x:Class="PrivateNetRouting.App.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics"
        Width="760" Height="680" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопки -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnRefresh" MinWidth="110" Click="OnRefresh"/>
                <Button x:Name="BtnOpenFolder" MinWidth="130" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="OnOpenFolder"/>
            </StackPanel>
        </Grid>

        <!-- Сводка: секции со строками «имя: значение», значение подсвечено по метке -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardBorder}"
                BorderThickness="1" CornerRadius="8" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SectionsPanel" Margin="0,0,8,0"/>
            </ScrollViewer>
        </Border>

        <!-- Логи: заголовок, статус операции ротации, кнопка ротации выбранного -->
        <Grid Grid.Row="2" Margin="0,14,0,6">
            <TextBlock x:Name="LogsHeaderText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="BtnRotate" MinWidth="110" Style="{StaticResource SecondaryButton}" Click="OnRotateLog"/>
            </StackPanel>
        </Grid>

        <!-- Список файлов (размер/дата) и хвост выбранного лога -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="LogsList" SelectionChanged="OnLogSelected"
                     Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardBorder}"/>
            <TextBox x:Name="TailBox" Grid.Column="1" Margin="8,0,0,0" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardBorder}"/>
        </Grid>
    </Grid>
</Window>
