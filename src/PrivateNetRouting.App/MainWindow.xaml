<Window x:Class="PrivateNetRouting.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivateNetRouting"
        Width="600" Height="440" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и индикатор -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Ellipse Width="12" Height="12" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Forward-прокси" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StateText}" FontSize="14" Foreground="{StaticResource Brush.TextSecondary}"
                       VerticalAlignment="Center" Margin="12,2,0,0"/>
        </StackPanel>

        <!-- Карточка статуса -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardBorder}"
                BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Слушатели" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Endpoints}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Активные соединения" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveConnections}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Всего / ошибок" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                    <Run Text="{Binding TotalConnections, Mode=OneWay}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding FailedConnections, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Апстрим SOCKS5" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SocksUpstream}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Конфиг" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConfigPath}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ConfigPath}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Лог" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LogPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogPath}"/>
            </Grid>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Запустить" Width="120" Click="OnStart" IsEnabled="{Binding CanStart}"/>
            <Button Content="Остановить" Width="120" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Click="OnStop" IsEnabled="{Binding CanStop}"/>
            <Button Content="Проверить цепочку" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Click="OnCheckChain"/>
        </StackPanel>

        <!-- Строка результата проверки -->
        <TextBlock Grid.Row="3" Text="{Binding CheckResult}" Foreground="{StaticResource Brush.TextSecondary}"
                   Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
