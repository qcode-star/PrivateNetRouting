<Window x:Class="PrivateNetRouting.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivateNetRouting"
        Width="620" Height="700" MinWidth="540" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header, indicator and language selection -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource Main.Header}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StateText}" FontSize="14" Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center" Margin="12,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Main.Language}" Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="LanguageBox" MinWidth="140" SelectionChanged="OnLanguageSelected"/>
            </StackPanel>
        </Grid>

        <!-- Proxy status card -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardBorder}"
                BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Main.Listeners}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Endpoints}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Main.ActiveConnections}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveConnections}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Main.TotalErrors}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                    <Run Text="{Binding TotalConnections, Mode=OneWay}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding FailedConnections, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Main.SocksUpstream}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SocksUpstream}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Main.Config}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConfigPath}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ConfigPath}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Main.Log}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LogPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogPath}"/>
            </Grid>
        </Border>

        <!-- Chain: state of the links and control -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardBorder}"
                BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,12,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Main.Chain}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ChainSummary}" Foreground="{StaticResource Brush.TextSecondary}"
                               VerticalAlignment="Center" Margin="10,1,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding ChainDetails}" FontSize="12" LineHeight="20"
                           Foreground="{StaticResource Brush.Text}"/>
                <!-- Idle auto-stop watchdog: explicit enable (rule #5), lives while the app is open -->
                <CheckBox x:Name="WatchdogBox" Content="{DynamicResource Main.Watchdog}" Margin="0,12,0,0"
                          Checked="OnWatchdogToggled" Unchecked="OnWatchdogToggled"/>
            </StackPanel>
        </Border>

        <!-- Direct-access guards: status of each layer (read-only) and control.
             Ban and policy request UAC (elevated helper), settings.json and WSL — without it. -->
        <Border Grid.Row="3" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardBorder}"
                BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,12,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Main.Guard}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="{DynamicResource Main.Guard.Button.Refresh}" MinWidth="100" Style="{StaticResource SecondaryButton}"
                            Click="OnRefreshGuards" IsEnabled="{Binding CanGuard}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Local ban (hosts + NRPT + firewall) -->
                    <Ellipse Grid.Row="0" Grid.Column="0" x:Name="BanDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="0,4,10,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Main.Guard.Ban}" VerticalAlignment="Center" Margin="0,4,12,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="BanDetail" Text="…" VerticalAlignment="Center" Margin="0,4,16,4" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                        <Button x:Name="BanOnButton" Content="{DynamicResource Main.Guard.Button.On}" Width="80" Click="OnGuardBanOn" IsEnabled="{Binding CanGuard}"/>
                        <Button x:Name="BanOffButton" Content="{DynamicResource Main.Guard.Button.Off}" Width="80" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}"
                                Click="OnGuardBanOff" IsEnabled="{Binding CanGuard}"/>
                    </StackPanel>

                    <!-- Managed policy egressProxyUrl -->
                    <Ellipse Grid.Row="1" Grid.Column="0" x:Name="PolicyDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="0,4,10,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Main.Guard.Policy}" VerticalAlignment="Center" Margin="0,4,12,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="PolicyDetail" Text="…" VerticalAlignment="Center" Margin="0,4,16,4" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                        <Button x:Name="PolicyOnButton" Content="{DynamicResource Main.Guard.Button.On}" Width="80" Click="OnGuardPolicyOn" IsEnabled="{Binding CanGuard}"/>
                        <Button x:Name="PolicyOffButton" Content="{DynamicResource Main.Guard.Button.Off}" Width="80" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}"
                                Click="OnGuardPolicyOff" IsEnabled="{Binding CanGuard}"/>
                    </StackPanel>

                    <!-- env in Claude Code settings.json (Windows) -->
                    <Ellipse Grid.Row="2" Grid.Column="0" x:Name="SettingsDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="0,4,10,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Main.Guard.Settings}" VerticalAlignment="Center" Margin="0,4,12,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="SettingsDetail" Text="…" VerticalAlignment="Center" Margin="0,4,16,4" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Row="2" Grid.Column="3" x:Name="SettingsSyncButton" Content="{DynamicResource Main.Guard.Button.Sync}" Width="166"
                            Click="OnGuardSettingsSync" IsEnabled="{Binding CanGuard}"/>

                    <!-- WSL config: startup script + distro settings.json -->
                    <Ellipse Grid.Row="3" Grid.Column="0" x:Name="WslDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="0,4,10,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Main.Guard.Wsl}" VerticalAlignment="Center" Margin="0,4,12,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="WslDetail" Text="…" VerticalAlignment="Center" Margin="0,4,16,4" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Row="3" Grid.Column="3" x:Name="WslSyncButton" Content="{DynamicResource Main.Guard.Button.Sync}" Width="166"
                            Click="OnGuardWslSync" IsEnabled="{Binding CanGuard}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Launch Claude and a browser with an isolated profile: chain check/bring-up and start
             with proxy flags (splash screen when waiting); next to it — a signal about an update found at startup -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="{DynamicResource Main.Button.LaunchClaude}" Width="160" Click="OnLaunchClaude" IsEnabled="{Binding CanLaunch}"/>
            <Button Content="{DynamicResource Main.Button.LaunchBrowser}" Width="140" Margin="8,0,0,0" Click="OnLaunchBrowser"
                    IsEnabled="{Binding CanLaunch}"/>
            <Button Content="{DynamicResource Main.Button.UpdateClaude}" Width="150" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Click="OnUpdateClaude" IsEnabled="{Binding CanLaunch}"/>
            <TextBlock Text="{Binding UpdateNotice}" Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="20,0,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{DynamicResource Main.Button.Start}" Width="120" Click="OnStart" IsEnabled="{Binding CanStart}"/>
            <Button Content="{DynamicResource Main.Button.Stop}" Width="120" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Click="OnStop" IsEnabled="{Binding CanStop}"/>
            <Button Content="{DynamicResource Main.Button.CheckChain}" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Click="OnCheckChain"/>
            <Button Content="{DynamicResource Main.Button.Diagnostics}" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Click="OnDiagnostics"/>
            <Button Content="{DynamicResource Main.Button.ChainUp}" Margin="24,0,0,0" Click="OnChainUp" IsEnabled="{Binding CanChainUp}"/>
            <Button Content="{DynamicResource Main.Button.ChainDown}" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Click="OnChainDown" IsEnabled="{Binding CanChainDown}"/>
        </StackPanel>

        <!-- Check result line -->
        <TextBlock Grid.Row="6" Text="{Binding CheckResult}" Foreground="{StaticResource Brush.TextSecondary}"
                   Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
