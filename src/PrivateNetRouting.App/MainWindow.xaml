<Window x:Class="PrivateNetRouting.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivateNetRouting"
        Width="600" Height="505" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок, индикатор и выбор языка -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource Main.Header}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StateText}" FontSize="14" Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center" Margin="12,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Main.Language}" Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="LanguageBox" MinWidth="140" SelectionChanged="OnLanguageSelected"/>
            </StackPanel>
        </Grid>

        <!-- Карточка статуса прокси -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardBorder}"
                BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Main.Listeners}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Endpoints}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Main.ActiveConnections}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveConnections}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Main.TotalErrors}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                    <Run Text="{Binding TotalConnections, Mode=OneWay}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding FailedConnections, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Main.SocksUpstream}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SocksUpstream}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Main.Config}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConfigPath}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ConfigPath}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Main.Log}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LogPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogPath}"/>
            </Grid>
        </Border>

        <!-- Цепочка: состояние звеньев и управление -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardBorder}"
                BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,12,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Main.Chain}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ChainSummary}" Foreground="{StaticResource Brush.TextSecondary}"
                               VerticalAlignment="Center" Margin="10,1,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding ChainDetails}" FontSize="12" LineHeight="20"
                           Foreground="{StaticResource Brush.Text}"/>
                <!-- Сторож автостопа: явное включение (правило №4), живёт, пока открыто приложение -->
                <CheckBox x:Name="WatchdogBox" Content="{DynamicResource Main.Watchdog}" Margin="0,12,0,0"
                          Checked="OnWatchdogToggled" Unchecked="OnWatchdogToggled"/>
            </StackPanel>
        </Border>

        <!-- Запуск Claude: проверка/подъём цепочки и старт с флагами прокси (заставка — при ожидании) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="{DynamicResource Main.Button.LaunchClaude}" Width="160" Click="OnLaunchClaude" IsEnabled="{Binding CanLaunch}"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{DynamicResource Main.Button.Start}" Width="120" Click="OnStart" IsEnabled="{Binding CanStart}"/>
            <Button Content="{DynamicResource Main.Button.Stop}" Width="120" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Click="OnStop" IsEnabled="{Binding CanStop}"/>
            <Button Content="{DynamicResource Main.Button.CheckChain}" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Click="OnCheckChain"/>
            <Button Content="{DynamicResource Main.Button.ChainUp}" Margin="24,0,0,0" Click="OnChainUp" IsEnabled="{Binding CanChainUp}"/>
            <Button Content="{DynamicResource Main.Button.ChainDown}" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Click="OnChainDown" IsEnabled="{Binding CanChainDown}"/>
        </StackPanel>

        <!-- Строка результата проверки -->
        <TextBlock Grid.Row="5" Text="{Binding CheckResult}" Foreground="{StaticResource Brush.TextSecondary}"
                   Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
