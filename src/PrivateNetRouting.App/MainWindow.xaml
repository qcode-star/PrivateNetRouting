<Window x:Class="PrivateNetRouting.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:PrivateNetRouting.App"
        Title="PrivateNetRouting"
        Width="820" MinWidth="700" MinHeight="200"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="{StaticResource Font.Body}"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!--
        Reading order: header (subject + language) → the chain (five stages in bring-up order,
        its control, the status rows: the proxy listeners with connection counters, the sidecar
        listeners, the config with its actions, the idle stopper) → guards → the launch actions
        → the result line. The body scrolls; the actions and the result line stay put.
        Both cards collapse to one compact row (overall status + the main control); the window
        then shrinks with the content (SizeToContent=Height, capped at the work area by code —
        past the cap the body scrolls). A chain operation expands the collapsed chain card and,
        on success, collapses it back.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: the subject of the window and the UI language -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Band}"
                BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1">
            <Grid Margin="24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource Brush.Accent}"
                            VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{DynamicResource Main.Header}" Style="{StaticResource Text.Title}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Main.Language}" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="LanguageBox" MinWidth="150" SelectionChanged="OnLanguageSelected"
                              AutomationProperties.Name="{DynamicResource Main.Language}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,0">

                <!-- Chain: the five stages in bring-up order with their control. The chain buttons
                     are the single lifecycle control: bring-up is idempotent, so a partially up
                     chain gets exactly its missing links. A bring-up runs live in this card —
                     spinner, elapsed time, the current step and the rail, no separate window.
                     Collapsed, the card is one row: overall status dot + word, the same two
                     buttons, the chevron; the chain operation expands it and collapses it back
                     on success. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Main.Chain}" Style="{StaticResource Text.Section}"/>
                                <Ellipse x:Name="ChainDot" Width="10" Height="10" Fill="{Binding ChainStateBrush}"
                                         VerticalAlignment="Center" Margin="12,1,0,1" Visibility="Collapsed"
                                         ToolTip="{Binding ChainSummary}"/>
                                <TextBlock Text="{Binding ChainSummary}" Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center" Margin="10,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Canvas x:Name="BusySpinner" Width="16" Height="16" Margin="0,0,10,0"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                    <Ellipse Width="16" Height="16" Stroke="{StaticResource Brush.ControlHover}" StrokeThickness="2"/>
                                    <Ellipse x:Name="SpinnerArc" Width="16" Height="16" Stroke="{StaticResource Brush.Accent}"
                                             StrokeThickness="2" StrokeDashArray="5.7 16.3" StrokeDashCap="Round"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Canvas>
                                <TextBlock x:Name="BusyElapsed" Style="{StaticResource Text.Mono}" Margin="0,0,12,0"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                                <Button Content="{DynamicResource Main.Button.ChainUp}" MinWidth="108"
                                        Style="{StaticResource SecondaryButton}" Click="OnChainUp" IsEnabled="{Binding CanChainUp}"/>
                                <Button Content="{DynamicResource Main.Button.ChainDown}" MinWidth="108" Margin="8,0,0,0"
                                        Style="{StaticResource GhostButton}" Click="OnChainDown" IsEnabled="{Binding CanChainDown}"/>
                                <Button x:Name="ChainCardToggle" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Click="OnToggleChainCard">
                                    <Path x:Name="ChainCardChevron" Data="{StaticResource Mark.Chevron.Up}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Everything the chevron hides: the rail, the live operation line and
                             the chain seen as data — the local proxy's listeners with connection
                             counters, the sidecar daemon's listeners, the config with its two
                             actions, and the idle stopper — each row carries its state word
                             next to the colour -->
                        <StackPanel x:Name="ChainDetails">
                            <!-- The rail itself, built by ChainRail: markers on a link, a link carrying the
                                 colour of the stage it leads to -->
                            <Grid x:Name="RailHost" Margin="0,14,0,0"/>

                            <!-- What the bring-up is doing right now; empty outside of an operation -->
                            <TextBlock x:Name="ChainDetail" Style="{StaticResource Text.Mono}" Margin="0,12,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed"/>
                            <TextBlock x:Name="ChainHint" Style="{StaticResource Text.Note}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed"/>

                            <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Listeners and connection counters of the local proxy stage -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Main.Listeners}"
                                       Style="{StaticResource Text.Note}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Endpoints}" Style="{StaticResource Text.Mono}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Endpoints}"
                                       VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{DynamicResource Main.Metric.Connections}"
                                           Margin="0,0,10,0"/>
                                <TextBlock Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text}"
                                           FontWeight="SemiBold" Text="{Binding ActiveConnections}"/>
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{DynamicResource Main.Metric.Active}"
                                           Margin="5,0,12,0"/>
                                <TextBlock Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text}"
                                           FontWeight="SemiBold" Text="{Binding TotalConnections}"/>
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{DynamicResource Main.Metric.Total}"
                                           Margin="5,0,12,0"/>
                                <TextBlock Style="{StaticResource Text.Mono}" Foreground="{Binding FailedBrush}"
                                           FontWeight="SemiBold" Text="{Binding FailedConnections}"/>
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{DynamicResource Main.Metric.Errors}"
                                           Margin="5,0,0,0"/>
                            </StackPanel>

                            <!-- Tailscale (sidecar daemon) listeners: its HTTP and SOCKS5 ports -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Main.TailscaleListeners}"
                                       Style="{StaticResource Text.Note}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TailscaleListeners}" Style="{StaticResource Text.Mono}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding TailscaleListeners}"
                                       VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TailscaleState}"
                                       Foreground="{Binding TailscaleBrush}" Style="{StaticResource Text.Caption}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,8"/>

                            <!-- User config of this installation; the path is cut in the middle
                                 so the file name stays readable. Open raises the folder (the user
                                 edits the file in their own editor), Reload re-reads it. -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Main.Config}"
                                       Style="{StaticResource Text.Note}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <app:PathTextBlock Grid.Row="2" Grid.Column="1" Source="{Binding ConfigPath}" Style="{StaticResource Text.Mono}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigPath}"
                                               VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="Right" Margin="0,0,0,8">
                                <Button Content="{DynamicResource Main.Config.Button.Open}" MinWidth="72"
                                        Style="{StaticResource GhostButton}" Click="OnConfigOpen"/>
                                <Button Content="{DynamicResource Main.Config.Button.Reload}" MinWidth="72" Margin="6,0,0,0"
                                        Style="{StaticResource GhostButton}" Click="OnConfigReload"/>
                            </StackPanel>

                            <!-- Idle auto-stop: a detached background worker — it keeps working after
                                 the application is closed, stops the WSL Claude host and the chain on
                                 idle, and switches itself off after firing. The flag re-arms it
                                 automatically after every chain raise (watchdog.autoStart). -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Main.IdleStop}"
                                       Style="{StaticResource Text.Note}" VerticalAlignment="Center" Margin="0,0,12,0"
                                       ToolTip="{DynamicResource Main.IdleStop.Note}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding IdleStopState}"
                                       Foreground="{Binding IdleStopBrush}" Style="{StaticResource Text.Caption}"
                                       FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       ToolTip="{DynamicResource Main.IdleStop.Note}"/>
                            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <CheckBox x:Name="AutoStartBox" Content="{DynamicResource Main.IdleStop.AutoStart}"
                                          VerticalAlignment="Center" Margin="0,0,12,0"
                                          ToolTip="{DynamicResource Main.IdleStop.AutoStart.Note}"
                                          Checked="OnAutoStartToggled" Unchecked="OnAutoStartToggled"/>
                                <Button Content="{Binding IdleStopAction}" MinWidth="86"
                                        Style="{StaticResource GhostButton}" Click="OnIdleStopToggled"
                                        IsEnabled="{Binding CanIdleStop}"/>
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Direct-access guards: state of each layer and its control.
                     Ban and policy request UAC (elevated helper), settings.json and WSL — without it.
                     Collapsed, the card is one row: the aggregate status dot + word and a single
                     combined action — "Enable all" (ban, policy, settings.json, WSL) or, when
                     everything is already on, "Disable all" (ban and policy). -->
                <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Main.Guard}" Style="{StaticResource Text.Section}"/>
                                <Ellipse x:Name="GuardDot" Width="10" Height="10" Fill="Gray"
                                         VerticalAlignment="Center" Margin="12,1,0,1" Visibility="Collapsed"/>
                                <TextBlock x:Name="GuardSummary" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="GuardRefreshButton" Content="{DynamicResource Main.Guard.Button.Refresh}"
                                        Style="{StaticResource GhostButton}" MinWidth="100" VerticalAlignment="Center"
                                        Click="OnRefreshGuards" IsEnabled="{Binding CanGuard}"/>
                                <Button x:Name="GuardAllButton" MinWidth="130" Margin="8,0,0,0"
                                        Style="{StaticResource AccentGhostButton}" Click="OnGuardAll"
                                        IsEnabled="{Binding CanGuard}" Visibility="Collapsed"/>
                                <Button x:Name="GuardCardToggle" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Click="OnToggleGuardsCard">
                                    <Path x:Name="GuardCardChevron" Data="{StaticResource Mark.Chevron.Up}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Everything the chevron hides: the elevation note and the four guard
                             layers with their state word and control -->
                        <StackPanel x:Name="GuardDetails">
                            <TextBlock Text="{DynamicResource Main.Guard.Note}" Style="{StaticResource Text.Note}"
                                       Margin="0,4,16,0" TextWrapping="Wrap"/>

                            <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Local ban (hosts + NRPT + firewall) -->
                            <Ellipse Grid.Row="0" Grid.Column="0" x:Name="BanDot" Width="10" Height="10" Fill="Gray"
                                     VerticalAlignment="Center" Margin="0,0,6,10" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Main.Guard.Ban}"
                                       Style="{StaticResource Text.Body}" MinWidth="128" VerticalAlignment="Center" Margin="0,0,14,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="BanState" Style="{StaticResource Text.Caption}"
                                       FontWeight="SemiBold" MinWidth="68" VerticalAlignment="Center" Margin="0,0,10,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="BanDetail" Text="…" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,16,10"/>
                            <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="BanOnButton" Content="{DynamicResource Main.Guard.Button.On}" MinWidth="72"
                                        Style="{StaticResource AccentGhostButton}" Click="OnGuardBanOn" IsEnabled="{Binding CanGuard}"/>
                                <Button x:Name="BanOffButton" Content="{DynamicResource Main.Guard.Button.Off}" MinWidth="72"
                                        Margin="6,0,0,0" Style="{StaticResource GhostButton}" Click="OnGuardBanOff"
                                        IsEnabled="{Binding CanGuard}"/>
                            </StackPanel>

                            <!-- Managed policy egressProxyUrl -->
                            <Ellipse Grid.Row="1" Grid.Column="0" x:Name="PolicyDot" Width="10" Height="10" Fill="Gray"
                                     VerticalAlignment="Center" Margin="0,0,6,10" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Main.Guard.Policy}"
                                       Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,14,10"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="PolicyState" Style="{StaticResource Text.Caption}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,10"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="PolicyDetail" Text="…" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,16,10"/>
                            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="PolicyOnButton" Content="{DynamicResource Main.Guard.Button.On}" MinWidth="72"
                                        Style="{StaticResource AccentGhostButton}" Click="OnGuardPolicyOn" IsEnabled="{Binding CanGuard}"/>
                                <Button x:Name="PolicyOffButton" Content="{DynamicResource Main.Guard.Button.Off}" MinWidth="72"
                                        Margin="6,0,0,0" Style="{StaticResource GhostButton}" Click="OnGuardPolicyOff"
                                        IsEnabled="{Binding CanGuard}"/>
                            </StackPanel>

                            <!-- env in Claude Code settings.json (Windows) -->
                            <Ellipse Grid.Row="2" Grid.Column="0" x:Name="SettingsDot" Width="10" Height="10" Fill="Gray"
                                     VerticalAlignment="Center" Margin="0,0,6,10" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Main.Guard.Settings}"
                                       Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,14,10"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="SettingsState" Style="{StaticResource Text.Caption}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,10"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="SettingsDetail" Text="…" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,16,10"/>
                            <Button Grid.Row="2" Grid.Column="4" x:Name="SettingsSyncButton" MinWidth="150" Margin="0,0,0,10"
                                    Content="{DynamicResource Main.Guard.Button.Sync}" Style="{StaticResource AccentGhostButton}"
                                    Click="OnGuardSettingsSync" IsEnabled="{Binding CanGuard}"/>

                            <!-- WSL config: startup script + distro settings.json -->
                            <Ellipse Grid.Row="3" Grid.Column="0" x:Name="WslDot" Width="10" Height="10" Fill="Gray"
                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Main.Guard.Wsl}"
                                       Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="WslState" Style="{StaticResource Text.Caption}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" x:Name="WslDetail" Text="…" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button Grid.Row="3" Grid.Column="4" x:Name="WslSyncButton" MinWidth="150"
                                    Content="{DynamicResource Main.Guard.Button.Sync}" Style="{StaticResource AccentGhostButton}"
                                    Click="OnGuardWslSync" IsEnabled="{Binding CanGuard}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Launch actions: the primary one, then the update; the note next to them is the signal
             about an update found at startup. The read-only checks sit opposite. -->
        <StackPanel Grid.Row="2" Margin="24,16,24,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource Main.Button.LaunchClaude}" MinWidth="200" Click="OnLaunchClaude"
                        IsEnabled="{Binding CanLaunch}"/>
                <Button Content="{DynamicResource Main.Button.LaunchBrowser}" MinWidth="120" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="OnLaunchBrowser" IsEnabled="{Binding CanLaunch}"/>
                <Button Content="{DynamicResource Main.Button.UpdateClaude}" MinWidth="160" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="OnUpdateClaude" IsEnabled="{Binding CanLaunch}"/>
            </StackPanel>
            <Grid Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource Main.Button.CheckChain}" MinWidth="130"
                            Style="{StaticResource GhostButton}" Click="OnCheckChain"/>
                    <Button Content="{DynamicResource Main.Button.Diagnostics}" MinWidth="130" Margin="8,0,0,0"
                            Style="{StaticResource GhostButton}" Click="OnDiagnostics"/>
                </StackPanel>
                <TextBlock Text="{Binding UpdateNotice}" Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                           TextWrapping="Wrap" MaxWidth="300"/>
            </Grid>
        </StackPanel>

        <!-- Result line of the last operation -->
        <TextBlock Grid.Row="3" Text="{Binding CheckResult}" Foreground="{Binding CheckResultBrush}"
                   Margin="24,12,24,16" TextWrapping="Wrap"/>
    </Grid>
</Window>