    <!-- Idle auto-stop: a detached background worker -->
    <s:String x:Key="Main.IdleStop">Idle stop</s:String>
    <s:String x:Key="Main.IdleStop.Note">Stops Claude in WSL and the chain when neither Claude nor Codex is in use. Lives as a separate background process: it keeps working after the application is closed and switches itself off after firing.</s:String>
    <s:String x:Key="Main.IdleStop.AutoStart">auto-start</s:String>
    <s:String x:Key="Main.IdleStop.AutoStart.Note">Arm the idle stopper automatically after every chain bring-up.</s:String>
    <s:String x:Key="Main.IdleStop.Running">running</s:String>
    <s:String x:Key="Main.IdleStop.Off">not running</s:String>
    <s:String x:Key="Main.IdleStop.Button.Start">Start</s:String>
    <s:String x:Key="Main.IdleStop.Button.Stop">Stop</s:String>
    <s:String x:Key="Main.IdleStop.Gate">The idle stopper arms only over a live chain: it stops the chain when Claude and Codex go idle, and a stopped chain takes it down itself.</s:String>
    <s:String x:Key="Main.IdleStop.StartedFmt">idle stop is on: checking every {0}s, runs in the background</s:String>
    <s:String x:Key="Main.IdleStop.StoppedManual">idle stop is off</s:String>

