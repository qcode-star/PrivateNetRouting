<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- English UI strings. Keys and placeholder sets ({0}, ...) must match across
         all Strings.*.xaml dictionaries; the language list is AppLanguage.Supported. -->

    <!-- Header and status -->
    <s:String x:Key="Main.Header">Forward proxy</s:String>
    <s:String x:Key="Main.State.Unknown">unknown</s:String>
    <s:String x:Key="Main.State.Running">running</s:String>
    <s:String x:Key="Main.State.Stopped">stopped</s:String>

    <!-- Status card -->
    <s:String x:Key="Main.Listeners">Listeners</s:String>
    <s:String x:Key="Main.ActiveConnections">Active connections</s:String>
    <s:String x:Key="Main.TotalErrors">Total / errors</s:String>
    <s:String x:Key="Main.SocksUpstream">SOCKS5 upstream</s:String>
    <s:String x:Key="Main.Config">Config</s:String>
    <s:String x:Key="Main.Log">Log</s:String>

    <!-- Chain -->
    <s:String x:Key="Main.Chain">Chain</s:String>
    <s:String x:Key="Main.Chain.FullUp">fully up</s:String>
    <s:String x:Key="Main.Chain.Partial">partial</s:String>
    <s:String x:Key="Main.Chain.Daemon.Listening">listening</s:String>
    <s:String x:Key="Main.Chain.Daemon.NoListener">no listener</s:String>
    <s:String x:Key="Main.Chain.Daemon.Down">down</s:String>
    <s:String x:Key="Main.Chain.Keeper.Running">running</s:String>
    <s:String x:Key="Main.Chain.Keeper.Down">down</s:String>
    <s:String x:Key="Main.Chain.Node.NoResponse">no response</s:String>
    <s:String x:Key="Main.Chain.Proxy.Running">running</s:String>
    <s:String x:Key="Main.Chain.Proxy.Stopped">stopped</s:String>
    <s:String x:Key="Main.Chain.Health.Ok">ok</s:String>
    <s:String x:Key="Main.Chain.Health.Fail">failed</s:String>
    <s:String x:Key="Main.Chain.DetailsFmt">daemon: {0}    keeper: {1}    node: {2}&#10;proxy: {3}    health: {4}</s:String>

    <!-- Idle watchdog -->
    <s:String x:Key="Main.Watchdog">Idle auto-stop (stops the WSL host and the chain when Claude is not in use)</s:String>
    <s:String x:Key="Main.Watchdog.StartedFmt">watchdog started: checking every {0}s</s:String>
    <s:String x:Key="Main.Watchdog.StoppedIdle">watchdog: idle — the WSL host and the chain are stopped</s:String>
    <s:String x:Key="Main.Watchdog.StoppedManual">watchdog stopped</s:String>

    <!-- Buttons -->
    <s:String x:Key="Main.Button.Start">Start</s:String>
    <s:String x:Key="Main.Button.Stop">Stop</s:String>
    <s:String x:Key="Main.Button.CheckChain">Check chain</s:String>
    <s:String x:Key="Main.Button.ChainUp">Start chain</s:String>
    <s:String x:Key="Main.Button.ChainDown">Stop chain</s:String>
    <s:String x:Key="Main.Button.LaunchClaude">Launch Claude</s:String>
    <s:String x:Key="Main.Button.UpdateClaude">Update Claude…</s:String>

    <!-- Operation results -->
    <s:String x:Key="Main.Check.Running">checking (CONNECT roundtrip)...</s:String>
    <s:String x:Key="Main.Check.AliveFmt">chain is alive: CONNECT via {0} succeeded</s:String>
    <s:String x:Key="Main.Check.DeadFmt">chain is not responding: CONNECT via {0} failed</s:String>
    <s:String x:Key="Main.Chain.UpDone">chain is up</s:String>
    <s:String x:Key="Main.Chain.DownDone">chain is stopped</s:String>
    <s:String x:Key="Main.Chain.Busy">operation in progress (confirm UAC if prompted)...</s:String>
    <s:String x:Key="Main.Chain.StateUnknownFmt">state unknown: {0}</s:String>
    <s:String x:Key="Main.ErrorFmt">error: {0}</s:String>
    <s:String x:Key="Main.LanguageSavedFmt">language saved to config: {0}</s:String>

    <!-- Claude launch -->
    <s:String x:Key="Main.Launch.Busy">launching (confirm UAC if prompted)...</s:String>
    <s:String x:Key="Main.Launch.DoneFmt">Claude launched (chain ready in {0} s)</s:String>

    <!-- Splash (chain rise while launching Claude) -->
    <s:String x:Key="Splash.Title">Launching Claude</s:String>
    <s:String x:Key="Splash.Subtitle">bringing up the proxy chain</s:String>
    <s:String x:Key="Splash.Subtitle.Fail">failed to bring up the chain</s:String>
    <s:String x:Key="Splash.Step.Daemon">Sidecar daemon (UAC)</s:String>
    <s:String x:Key="Splash.Step.Keeper">Keeper watch-ipn</s:String>
    <s:String x:Key="Splash.Step.Node">Tailscale node (up)</s:String>
    <s:String x:Key="Splash.Step.Proxy">Forward proxy</s:String>
    <s:String x:Key="Splash.Step.Health">Chain responds (CONNECT)</s:String>
    <s:String x:Key="Splash.SkipNote">already up</s:String>
    <s:String x:Key="Splash.Hint.Uac">Confirm the UAC prompt: the sidecar daemon starts with administrator rights.</s:String>
    <s:String x:Key="Splash.CompleteFmt">Ready in {0} s</s:String>
    <s:String x:Key="Splash.Fail.HintFmt">Details: {0}</s:String>
    <s:String x:Key="Splash.Button.OpenLog">Open log</s:String>
    <s:String x:Key="Splash.Button.Close">Close</s:String>

    <!-- Update window (manual Claude Desktop MSIX update) -->
    <s:String x:Key="Update.Title">Update Claude Desktop</s:String>
    <s:String x:Key="Update.Header">Claude Desktop</s:String>
    <s:String x:Key="Update.SubHeader">Manual update (MSIX)</s:String>
    <s:String x:Key="Update.Step.Check">Versions</s:String>
    <s:String x:Key="Update.Step.Chain">Proxy chain</s:String>
    <s:String x:Key="Update.Step.Download">Download</s:String>
    <s:String x:Key="Update.Step.Install">Install</s:String>
    <s:String x:Key="Update.Check.Running">checking the installed version and the AppX journal</s:String>
    <s:String x:Key="Update.Check.UpToDateFmt">Installed {0} — the version is up to date, nothing to install.</s:String>
    <s:String x:Key="Update.Check.AvailableFmt">Installed {0} → offered {1}</s:String>
    <s:String x:Key="Update.Check.NoUrl">The package URL was not found in the AppX journal. Launch Claude Desktop: its updater leaves a fresh address in the journal about once an hour. Or paste the package address (.msix) below.</s:String>
    <s:String x:Key="Update.Check.InvalidUrl">This address does not point to an .msix package — paste another one.</s:String>
    <s:String x:Key="Update.Check.NotInstalled">Claude Desktop is not installed as an MSIX package — there is nothing to update.</s:String>
    <s:String x:Key="Update.Hint.Uac">Confirm the UAC prompt: the sidecar daemon starts with administrator rights.</s:String>
    <s:String x:Key="Update.Download.RunningFmt">{0} of {1} · {2}/s · {3} left</s:String>
    <s:String x:Key="Update.Download.StalledFmt">No progress for {0} min — the downloader keeps retrying on its own.</s:String>
    <s:String x:Key="Update.Verify.OkFmt">Package verified: {0}; the publisher matches ({1}).</s:String>
    <s:String x:Key="Update.Pause.Message">The package is ready. Installation will close Claude — continue?</s:String>
    <s:String x:Key="Update.Install.NoClose">Installation is in progress — do not close the window.</s:String>
    <s:String x:Key="Update.Install.RightsHintFmt">If it complains about rights, run from an admin console:&#10;Add-AppxPackage -Path "{0}" -ForceApplicationShutdown</s:String>
    <s:String x:Key="Update.Install.VersionWarn">Warning: the version did not change after installation — check the AppX journal.</s:String>
    <s:String x:Key="Update.Done.InstalledFmt">Installed: {0} → {1}</s:String>
    <s:String x:Key="Update.Done.Stopped">Stopped.</s:String>
    <s:String x:Key="Update.Done.StoppedFmt">Stopped: downloaded {0} of {1}; the partial download is kept in the cache.</s:String>
    <s:String x:Key="Update.Done.DeferredFmt">Installation deferred; the package is in the cache: {0}</s:String>
    <s:String x:Key="Update.Launch.Done">Claude launched.</s:String>
    <s:String x:Key="Update.Url.Label">Package address (.msix)</s:String>
    <s:String x:Key="Update.Button.Stop">Stop</s:String>
    <s:String x:Key="Update.Button.OpenLog">Open log</s:String>
    <s:String x:Key="Update.Button.Close">Close</s:String>
    <s:String x:Key="Update.Button.Retry">Retry</s:String>
    <s:String x:Key="Update.Button.LaunchClaude">Launch Claude</s:String>
    <s:String x:Key="Update.Button.InstallNow">Install now</s:String>
    <s:String x:Key="Update.Button.Defer">Defer</s:String>
    <s:String x:Key="Update.Button.ContinueWithUrl">Continue with this URL</s:String>
    <s:String x:Key="Update.ConfirmClose">Stop the update and close?</s:String>

    <!-- Settings -->
    <s:String x:Key="Main.Language">Language</s:String>
    <s:String x:Key="Main.Language.Auto">System default</s:String>
</ResourceDictionary>
