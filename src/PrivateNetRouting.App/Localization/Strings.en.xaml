<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- English UI strings. Keys and placeholder sets ({0}, ...) must match across
         all Strings.*.xaml dictionaries; the language list is AppLanguage.Supported. -->

    <!-- Header and status -->
    <s:String x:Key="Main.Header">Forward proxy</s:String>
    <s:String x:Key="Main.State.Unknown">unknown</s:String>
    <s:String x:Key="Main.State.Running">running</s:String>
    <s:String x:Key="Main.State.Stopped">stopped</s:String>

    <!-- Status card -->
    <s:String x:Key="Main.Listeners">Listeners</s:String>
    <s:String x:Key="Main.Metric.Active">active</s:String>
    <s:String x:Key="Main.Metric.Total">total</s:String>
    <s:String x:Key="Main.Metric.Errors">errors</s:String>
    <s:String x:Key="Main.SocksUpstream">SOCKS5 upstream</s:String>
    <s:String x:Key="Main.Config">Config</s:String>
    <s:String x:Key="Main.Log">Log</s:String>

    <!-- Chain -->
    <s:String x:Key="Main.Chain">Chain</s:String>
    <s:String x:Key="Main.Chain.FullUp">fully up</s:String>
    <s:String x:Key="Main.Chain.Partial">partial</s:String>
    <s:String x:Key="Main.Rail.Daemon">Sidecar daemon</s:String>
    <s:String x:Key="Main.Rail.Keeper">Keeper</s:String>
    <s:String x:Key="Main.Rail.Node">Tailscale node</s:String>
    <s:String x:Key="Main.Rail.Proxy">Forward proxy</s:String>
    <s:String x:Key="Main.Rail.Health">CONNECT check</s:String>
    <!-- Stage words while a bring-up runs in the chain card -->
    <s:String x:Key="Main.Rail.Waiting">waiting</s:String>
    <s:String x:Key="Main.Rail.Starting">starting</s:String>
    <s:String x:Key="Main.Rail.Ready">ready</s:String>
    <s:String x:Key="Main.Rail.Failed">failed</s:String>
    <s:String x:Key="Main.Chain.Skipped">already up</s:String>
    <s:String x:Key="Main.Chain.Hint.Uac">Confirm the UAC prompt: the sidecar daemon starts with administrator rights.</s:String>
    <s:String x:Key="Main.Chain.Daemon.Listening">listening</s:String>
    <s:String x:Key="Main.Chain.Daemon.NoListener">no listener</s:String>
    <s:String x:Key="Main.Chain.Daemon.Down">down</s:String>
    <s:String x:Key="Main.Chain.Keeper.Running">running</s:String>
    <s:String x:Key="Main.Chain.Keeper.Down">down</s:String>
    <s:String x:Key="Main.Chain.Node.NoResponse">no response</s:String>
    <s:String x:Key="Main.Chain.Proxy.Running">running</s:String>
    <s:String x:Key="Main.Chain.Proxy.Stopped">stopped</s:String>
    <s:String x:Key="Main.Chain.Health.Ok">ok</s:String>
    <s:String x:Key="Main.Chain.Health.Fail">failed</s:String>
    <s:String x:Key="Main.Chain.Health.Idle">not checked</s:String>

    <!-- Idle watchdog -->
    <s:String x:Key="Main.Watchdog">Idle auto-stop (stops the WSL host and the chain when Claude is not in use)</s:String>
    <s:String x:Key="Main.Watchdog.StartedFmt">watchdog started: checking every {0}s</s:String>
    <s:String x:Key="Main.Watchdog.StoppedIdle">watchdog: idle — the WSL host and the chain are stopped</s:String>
    <s:String x:Key="Main.Watchdog.StoppedManual">watchdog stopped</s:String>

    <!-- Buttons -->
    <s:String x:Key="Main.Button.Start">Start</s:String>
    <s:String x:Key="Main.Button.Stop">Stop</s:String>
    <s:String x:Key="Main.Button.CheckChain">Check chain</s:String>
    <s:String x:Key="Main.Button.Diagnostics">Diagnostics…</s:String>
    <s:String x:Key="Main.Button.ChainUp">Start chain</s:String>
    <s:String x:Key="Main.Button.ChainDown">Stop chain</s:String>
    <s:String x:Key="Main.Button.LaunchClaude">Launch Claude</s:String>
    <s:String x:Key="Main.Button.LaunchBrowser">Browser</s:String>
    <s:String x:Key="Main.Button.UpdateClaude">Update Claude…</s:String>

    <!-- Operation results -->
    <s:String x:Key="Main.Check.Running">checking (CONNECT roundtrip)...</s:String>
    <s:String x:Key="Main.Check.AliveFmt">chain is alive: CONNECT via {0} succeeded</s:String>
    <s:String x:Key="Main.Check.DeadFmt">chain is not responding: CONNECT via {0} failed</s:String>
    <s:String x:Key="Main.Chain.UpDone">chain is up</s:String>
    <s:String x:Key="Main.Chain.DownDone">chain is stopped</s:String>
    <s:String x:Key="Main.Chain.Busy">operation in progress (confirm UAC if prompted)...</s:String>
    <s:String x:Key="Main.Chain.StateUnknownFmt">state unknown: {0}</s:String>
    <s:String x:Key="Main.ErrorFmt">error: {0}</s:String>
    <s:String x:Key="Main.LanguageSavedFmt">language saved to config: {0}</s:String>

    <!-- Claude launch -->
    <s:String x:Key="Main.Launch.Busy">launching (confirm UAC if prompted)...</s:String>
    <s:String x:Key="Main.Launch.DoneFmt">Claude launched (chain ready in {0} s)</s:String>
    <s:String x:Key="Main.Launch.AlreadyRunning">Claude is already running — the window is shown without launching again</s:String>

    <!-- Browser launch (isolated profile) -->
    <s:String x:Key="Main.Browser.DoneFmt">Browser launched (chain ready in {0} s)</s:String>
    <s:String x:Key="Main.Browser.AlreadyRunning">Browser is already running with our profile — bring it up from the taskbar</s:String>

    <!-- Claude update: startup check notice -->
    <s:String x:Key="Main.Update.AvailableFmt">Claude update available: {0} → {1}</s:String>
    <s:String x:Key="Main.Update.Available">A Claude update is available</s:String>

    <!-- Guards: direct access control (local ban, egress policy, settings.json env, WSL config) -->
    <s:String x:Key="Main.Guard">Guards: direct access control</s:String>
    <s:String x:Key="Main.Guard.Note">Enable and Disable ask for administrator rights; settings.json and WSL are written without elevation.</s:String>
    <s:String x:Key="Main.Guard.Button.Refresh">Refresh</s:String>
    <s:String x:Key="Main.Guard.Button.On">Enable</s:String>
    <s:String x:Key="Main.Guard.Button.Off">Disable</s:String>
    <s:String x:Key="Main.Guard.Button.Sync">Sync</s:String>
    <s:String x:Key="Main.Guard.Unknown">state unknown</s:String>
    <s:String x:Key="Main.Guard.State.On">on</s:String>
    <s:String x:Key="Main.Guard.State.Off">off</s:String>
    <s:String x:Key="Main.Guard.State.Partial">partial</s:String>
    <s:String x:Key="Main.Guard.State.Unknown">unknown</s:String>
    <s:String x:Key="Main.Guard.Busy">guard operation in progress (confirm UAC if prompted)...</s:String>
    <s:String x:Key="Main.Guard.Ban">Local ban</s:String>
    <s:String x:Key="Main.Guard.Ban.DetailFmt">hosts: {0} names · NRPT: {1} namespaces · firewall: {2} rules</s:String>
    <s:String x:Key="Main.Guard.Ban.Off">no hosts/NRPT/firewall rules</s:String>
    <s:String x:Key="Main.Guard.Ban.Stale">The hosts block differs from the configured domain list — enable the ban again to refresh it.</s:String>
    <s:String x:Key="Main.Guard.Ban.LiveFmt">Local ban applied. DNS probe: {0}; direct connection: {1}.</s:String>
    <s:String x:Key="Main.Guard.Live.Blocked">blocked</s:String>
    <s:String x:Key="Main.Guard.Live.Open">OPEN</s:String>
    <s:String x:Key="Main.Guard.Policy">Egress policy</s:String>
    <s:String x:Key="Main.Guard.Policy.DetailFmt">egressProxyUrl = {0}</s:String>
    <s:String x:Key="Main.Guard.Policy.Off">policy is not set (Claude may go direct)</s:String>
    <s:String x:Key="Main.Guard.Policy.OtherFmt">{0} (expected {1})</s:String>
    <s:String x:Key="Main.Guard.Policy.OnDone">Egress policy is set: Claude always goes through the proxy.</s:String>
    <s:String x:Key="Main.Guard.Policy.OffDone">Egress policy is removed.</s:String>
    <s:String x:Key="Main.Guard.Settings">settings.json (Windows)</s:String>
    <s:String x:Key="Main.Guard.Settings.OkFmt">env is up to date: proxy {0}</s:String>
    <s:String x:Key="Main.Guard.Settings.NoFile">settings.json was not found</s:String>
    <s:String x:Key="Main.Guard.Settings.MismatchFmt">HTTPS_PROXY={0}, NO_PROXY={1} — differs from the config</s:String>
    <s:String x:Key="Main.Guard.Settings.DoneFmt">settings.json updated: proxy {0} (backup: {1})</s:String>
    <s:String x:Key="Main.Guard.Backup.None">no backup (file was created)</s:String>
    <s:String x:Key="Main.Guard.Wsl">WSL config</s:String>
    <s:String x:Key="Main.Guard.Wsl.Off.Mode">layer is disabled (guard.wsl.mode=off)</s:String>
    <s:String x:Key="Main.Guard.Wsl.AutoNone">auto: none of the configured distros is installed</s:String>
    <s:String x:Key="Main.Guard.Wsl.NotConfigured">not configured (guard.wsl.distros)</s:String>
    <s:String x:Key="Main.Guard.Wsl.NotInstalled">distro is not installed</s:String>
    <s:String x:Key="Main.Guard.Wsl.NotRunning">distro is not running — start it to check</s:String>
    <s:String x:Key="Main.Guard.Wsl.NoScript">WSL startup script not found</s:String>
    <s:String x:Key="Main.Guard.Wsl.DistroOnFmt">{0}: port {1}</s:String>
    <s:String x:Key="Main.Guard.Wsl.SkippedFmt">WSL sync skipped: {0}</s:String>
    <s:String x:Key="Main.Guard.Wsl.DistroSkippedFmt">{0}: skipped — {1}</s:String>
    <s:String x:Key="Main.Guard.Wsl.DistroDoneFmt">{0}: proxy {1} written</s:String>

    <!-- Tray -->
    <s:String x:Key="Tray.Open">Open</s:String>
    <s:String x:Key="Tray.Exit">Exit</s:String>

    <!-- Update window (manual Claude Desktop MSIX update) -->
    <s:String x:Key="Update.Title">Update Claude Desktop</s:String>
    <s:String x:Key="Update.Header">Claude Desktop</s:String>
    <s:String x:Key="Update.SubHeader">Manual update (MSIX)</s:String>
    <s:String x:Key="Update.Step.Check">Versions</s:String>
    <s:String x:Key="Update.Step.Chain">Proxy chain</s:String>
    <s:String x:Key="Update.Step.Download">Download</s:String>
    <s:String x:Key="Update.Step.Install">Install</s:String>
    <s:String x:Key="Update.Check.Running">checking the installed version and the AppX journal</s:String>
    <s:String x:Key="Update.Check.UpToDateFmt">Installed {0} — the version is up to date, nothing to install.</s:String>
    <s:String x:Key="Update.Check.AvailableFmt">Installed {0} → offered {1}</s:String>
    <s:String x:Key="Update.Check.NoUrl">The package URL was not found in the AppX journal. Launch Claude Desktop: its updater leaves a fresh address in the journal about once an hour. Or paste the package address (.msix) below.</s:String>
    <s:String x:Key="Update.Check.InvalidUrl">This address does not point to an .msix package — paste another one.</s:String>
    <s:String x:Key="Update.Check.NotInstalled">Claude Desktop is not installed as an MSIX package — there is nothing to update.</s:String>
    <s:String x:Key="Update.Hint.Uac">Confirm the UAC prompt: the sidecar daemon starts with administrator rights.</s:String>
    <s:String x:Key="Update.Download.RunningFmt">{0} of {1} · {2}/s · {3} left</s:String>
    <s:String x:Key="Update.Download.StalledFmt">No progress for {0} min — the downloader keeps retrying on its own.</s:String>
    <s:String x:Key="Update.Verify.OkFmt">Package verified: {0}; the publisher matches ({1}).</s:String>
    <s:String x:Key="Update.Pause.Message">The package is ready. Installation will close Claude — continue?</s:String>
    <s:String x:Key="Update.Install.NoClose">Installation is in progress — do not close the window.</s:String>
    <s:String x:Key="Update.Install.RightsHintFmt">If it complains about rights, run from an admin console:&#10;Add-AppxPackage -Path "{0}" -ForceApplicationShutdown</s:String>
    <s:String x:Key="Update.Install.VersionWarn">Warning: the version did not change after installation — check the AppX journal.</s:String>
    <s:String x:Key="Update.Done.InstalledFmt">Installed: {0} → {1}</s:String>
    <s:String x:Key="Update.Done.Stopped">Stopped.</s:String>
    <s:String x:Key="Update.Done.StoppedFmt">Stopped: downloaded {0} of {1}; the partial download is kept in the cache.</s:String>
    <s:String x:Key="Update.Done.DeferredFmt">Installation deferred; the package is in the cache: {0}</s:String>
    <s:String x:Key="Update.Launch.Done">Claude launched.</s:String>
    <s:String x:Key="Update.Url.Label">Package address (.msix)</s:String>
    <s:String x:Key="Update.Button.Stop">Stop</s:String>
    <s:String x:Key="Update.Button.OpenLog">Open log</s:String>
    <s:String x:Key="Update.Button.Close">Close</s:String>
    <s:String x:Key="Update.Button.Retry">Retry</s:String>
    <s:String x:Key="Update.Button.LaunchClaude">Launch Claude</s:String>
    <s:String x:Key="Update.Button.InstallNow">Install now</s:String>
    <s:String x:Key="Update.Button.Defer">Defer</s:String>
    <s:String x:Key="Update.Button.ContinueWithUrl">Continue with this URL</s:String>
    <s:String x:Key="Update.ConfirmClose">Stop the update and close?</s:String>

    <!-- Settings -->
    <s:String x:Key="Main.Language">Language</s:String>
    <s:String x:Key="Main.Language.Auto">System default</s:String>

    <!-- Diagnostics window (read-only state summary + log viewer) -->
    <s:String x:Key="Diag.Title">Diagnostics</s:String>
    <s:String x:Key="Diag.Header">State summary (read-only)</s:String>
    <s:String x:Key="Diag.Button.Refresh">Refresh</s:String>
    <s:String x:Key="Diag.Button.OpenFolder">Open folder</s:String>
    <s:String x:Key="Diag.Button.Rotate">Rotate</s:String>
    <s:String x:Key="Diag.Busy">collecting (a live CONNECT roundtrip is included)...</s:String>
    <s:String x:Key="Diag.ChainStopped">The chain is stopped — this is normal while Claude is not needed. Raise it with the Claude shortcut or the Launch button.</s:String>
    <s:String x:Key="Diag.Section.chain">Chain</s:String>
    <s:String x:Key="Diag.Section.proxy">Forward proxy</s:String>
    <s:String x:Key="Diag.Section.health">Health</s:String>
    <s:String x:Key="Diag.Section.guards">Guards</s:String>
    <s:String x:Key="Diag.Section.watchdog">Idle supervisor</s:String>
    <s:String x:Key="Diag.Section.logs">Logs</s:String>
    <s:String x:Key="Diag.Logs.Empty">No log files yet.</s:String>
</ResourceDictionary>
