<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- Русские строки UI. Ключи и набор плейсхолдеров ({0}, ...) должны совпадать
         во всех словарях Strings.*.xaml; список языков — AppLanguage.Supported. -->

    <!-- Заголовок и статус -->
    <s:String x:Key="Main.Header">Forward-прокси</s:String>
    <s:String x:Key="Main.State.Unknown">неизвестно</s:String>
    <s:String x:Key="Main.State.Running">работает</s:String>
    <s:String x:Key="Main.State.Stopped">остановлен</s:String>

    <!-- Карточка статуса -->
    <s:String x:Key="Main.Listeners">Слушатели</s:String>
    <s:String x:Key="Main.ActiveConnections">Активные соединения</s:String>
    <s:String x:Key="Main.TotalErrors">Всего / ошибок</s:String>
    <s:String x:Key="Main.SocksUpstream">Апстрим SOCKS5</s:String>
    <s:String x:Key="Main.Config">Конфиг</s:String>
    <s:String x:Key="Main.Log">Лог</s:String>

    <!-- Цепочка -->
    <s:String x:Key="Main.Chain">Цепочка</s:String>
    <s:String x:Key="Main.Chain.FullUp">полностью поднята</s:String>
    <s:String x:Key="Main.Chain.Partial">не полностью</s:String>
    <s:String x:Key="Main.Chain.Daemon.Listening">слушает</s:String>
    <s:String x:Key="Main.Chain.Daemon.NoListener">без слушателя</s:String>
    <s:String x:Key="Main.Chain.Daemon.Down">нет</s:String>
    <s:String x:Key="Main.Chain.Keeper.Running">работает</s:String>
    <s:String x:Key="Main.Chain.Keeper.Down">нет</s:String>
    <s:String x:Key="Main.Chain.Node.NoResponse">нет ответа</s:String>
    <s:String x:Key="Main.Chain.Proxy.Running">работает</s:String>
    <s:String x:Key="Main.Chain.Proxy.Stopped">остановлен</s:String>
    <s:String x:Key="Main.Chain.Health.Ok">живо</s:String>
    <s:String x:Key="Main.Chain.Health.Fail">не прошло</s:String>
    <s:String x:Key="Main.Chain.DetailsFmt">демон: {0}    кипер: {1}    узел: {2}&#10;прокси: {3}    здоровье: {4}</s:String>

    <!-- Сторож автостопа -->
    <s:String x:Key="Main.Watchdog">Автостоп по простою (гасит WSL-хост и цепочку, когда Claude не используется)</s:String>
    <s:String x:Key="Main.Watchdog.StartedFmt">сторож запущен: проверка каждые {0} с</s:String>
    <s:String x:Key="Main.Watchdog.StoppedIdle">сторож: простой — WSL-хост и цепочка остановлены</s:String>
    <s:String x:Key="Main.Watchdog.StoppedManual">сторож остановлен</s:String>

    <!-- Кнопки -->
    <s:String x:Key="Main.Button.Start">Запустить</s:String>
    <s:String x:Key="Main.Button.Stop">Остановить</s:String>
    <s:String x:Key="Main.Button.CheckChain">Проверить цепочку</s:String>
    <s:String x:Key="Main.Button.ChainUp">Поднять цепочку</s:String>
    <s:String x:Key="Main.Button.ChainDown">Остановить цепочку</s:String>
    <s:String x:Key="Main.Button.LaunchClaude">Запустить Claude</s:String>

    <!-- Результаты операций -->
    <s:String x:Key="Main.Check.Running">проверяю (CONNECT-roundtrip)...</s:String>
    <s:String x:Key="Main.Check.AliveFmt">цепочка жива: CONNECT через {0} прошёл</s:String>
    <s:String x:Key="Main.Check.DeadFmt">цепочка не отвечает: CONNECT через {0} не прошёл</s:String>
    <s:String x:Key="Main.Chain.UpDone">цепочка поднята</s:String>
    <s:String x:Key="Main.Chain.DownDone">цепочка остановлена</s:String>
    <s:String x:Key="Main.Chain.Busy">выполняется операция (подтверди UAC, если появится)...</s:String>
    <s:String x:Key="Main.Chain.StateUnknownFmt">состояние неизвестно: {0}</s:String>
    <s:String x:Key="Main.ErrorFmt">ошибка: {0}</s:String>
    <s:String x:Key="Main.LanguageSavedFmt">язык сохранён в конфиге: {0}</s:String>

    <!-- Запуск Claude -->
    <s:String x:Key="Main.Launch.Busy">запуск (подтверди UAC, если появится)...</s:String>
    <s:String x:Key="Main.Launch.DoneFmt">Claude запущен (цепочка готова за {0} с)</s:String>

    <!-- Заставка (подъём цепочки при запуске Claude) -->
    <s:String x:Key="Splash.Title">Запуск Claude</s:String>
    <s:String x:Key="Splash.Subtitle">поднимаю прокси-цепочку</s:String>
    <s:String x:Key="Splash.Subtitle.Fail">не удалось поднять цепочку</s:String>
    <s:String x:Key="Splash.Step.Daemon">Демон sidecar (нужен UAC)</s:String>
    <s:String x:Key="Splash.Step.Keeper">Кипер watch-ipn</s:String>
    <s:String x:Key="Splash.Step.Node">Узел tailscale (up)</s:String>
    <s:String x:Key="Splash.Step.Proxy">Локальный прокси</s:String>
    <s:String x:Key="Splash.Step.Health">Цепочка отвечает (CONNECT)</s:String>
    <s:String x:Key="Splash.SkipNote">уже работает</s:String>
    <s:String x:Key="Splash.Hint.Uac">Подтверди окно UAC: демон sidecar запускается с правами администратора.</s:String>
    <s:String x:Key="Splash.CompleteFmt">Готово за {0} с</s:String>
    <s:String x:Key="Splash.Fail.HintFmt">Подробности: {0}</s:String>
    <s:String x:Key="Splash.Button.OpenLog">Открыть лог</s:String>
    <s:String x:Key="Splash.Button.Close">Закрыть</s:String>

    <!-- Настройки -->
    <s:String x:Key="Main.Language">Язык</s:String>
    <s:String x:Key="Main.Language.Auto">Как в системе</s:String>
</ResourceDictionary>
