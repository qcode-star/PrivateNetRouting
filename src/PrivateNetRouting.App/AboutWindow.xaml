<Window x:Class="PrivateNetRouting.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Body}"
        SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="24">
        <TextBlock x:Name="HeaderText" Style="{StaticResource Text.Title}"/>
        <TextBlock x:Name="TaglineText" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="VersionText" Style="{StaticResource Text.Mono}" Margin="0,16,0,0"/>
        <!-- The project site: a machine value, so monospaced; the click opens it in the browser -->
        <TextBlock Margin="0,4,0,0">
            <Hyperlink x:Name="SiteLink" Foreground="{StaticResource Brush.Accent}" Click="OnOpenSite">
                <Run x:Name="SiteRun" FontFamily="{StaticResource Font.Mono}"/>
            </Hyperlink>
        </TextBlock>
        <Button x:Name="BtnClose" MinWidth="110" Margin="0,20,0,0" HorizontalAlignment="Right"
                Style="{StaticResource GhostButton}" Click="OnClose"/>
    </StackPanel>
</Window>
