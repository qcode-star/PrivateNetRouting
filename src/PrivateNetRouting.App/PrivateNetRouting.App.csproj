<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PrivateNetRouting.Core\PrivateNetRouting.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icon family: app.ico is the neutral "both apps" one (also the exe's own icon),
         app-claude.ico / app-codex.ico are the single-app profile variants. -->
    <Resource Include="Assets\*.ico" />
    <!-- WinForms is needed only for the tray (TrayIcon.cs with an alias): no global usings,
         so that System.Windows.Forms/System.Drawing do not conflict with WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- our own Main: the windowless roles run before WPF starts (Program.cs, HeadlessHost.cs) -->
    <StartupObject>PrivateNetRouting.App.Program</StartupObject>
  </PropertyGroup>

</Project>
